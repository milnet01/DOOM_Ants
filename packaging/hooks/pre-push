#!/usr/bin/env bash
#
# pre-push -- hand the push to the machine-wide gate (~/.claude/githooks/pre-push).
#
# That hook scans the pushed commits for secrets, then runs packaging/ci-local.sh
# against the PUSHED commits (in place when the tree is clean at the pushed tip,
# otherwise in a fresh checkout). It skips a tree a full run already passed, which
# is what lets release.sh's separate tag push through without a second run.
# How this repository answers its questions is committed in .ants/gate.conf:
# which pushes are documentation-only (build.yml's own paths-ignore list, via
# ci-local.sh --classify-docs) and what such a push runs (ci-local.sh --docs).
#
# INSTALL (once per clone -- git hooks are not themselves version-controlled):
#     git config core.hooksPath packaging/hooks
#
# BYPASS a single push:  git push --no-verify   (a bypass is the user's call;
# ~/.claude/standards/commits.md § 2.3 says when)
#
set -Eeuo pipefail

GLOBAL_HOOK="${ANTS_GLOBAL_HOOKS:-$HOME/.claude/githooks}/pre-push"

if [[ -x $GLOBAL_HOOK ]]; then
    exec "$GLOBAL_HOOK" "$@"
fi

# A clone on a machine without the shared hook gets no gate, and says so rather
# than exiting 0 in silence: a check that did not run must not look like a pass.
printf 'pre-push: no push gate on this machine (%s is absent).\n' "$GLOBAL_HOOK" >&2
printf 'pre-push: NOTHING WAS CHECKED. Run packaging/ci-local.sh by hand before pushing.\n' >&2
exit 0
