#version 460
//
// DOOM-0009 path tracer — build step 6-d: temporal anti-aliasing upsampler (TAAU),
// phase 1. The final stage of the mode-6 denoised path: it takes the denoised image
// the SVGF composite produced at RENDER resolution (a sub-rectangle of the storage
// images when the render scale is below 100%) and reconstructs a full DISPLAY-
// resolution image by accumulating successive sub-pixel-jittered frames, reprojected
// through the per-pixel motion vectors.
//
// This is the custom upscaler the spec's §4.4 names first; FSR 2 / FSR 3.1 are later
// phases that consume the SAME contract (a render-res colour + motion-vector pair, a
// per-frame jitter, and a display-res history/output), so the plumbing is built once
// here. Phase 1 is a compact, recognised TAAU: bilinear current sample (un-jittered),
// motion-reprojected history, a 3x3 neighbourhood colour clamp to suppress ghosting,
// and a history-weighted blend. Variance clipping / depth-aware disocclusion are a
// later refinement (tuning rides the step-7 perf pass).
//
// Colour is the composite's tonemapped LDR sRGB output (rgba8); accumulating in that
// space is the simple-TAA convention and adequate for phase 1 — a linear/HDR tap
// point is an option an FSR backend may prefer, behind the same resource contract.
//
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba8) uniform readonly  image2D inColor;   // render-res denoised
layout(set = 0, binding = 1, rg16f) uniform readonly  image2D inMotion;  // render-res cur->prev px
layout(set = 0, binding = 2, rgba16f) uniform image2D hist[2];           // display-res history
layout(set = 0, binding = 3, rgba8) uniform writeonly image2D outColor;  // display-res output

layout(push_constant) uniform PC {
    uvec4 misc;    // x = cur parity, y = display W, z = display H, w reserved
    uvec4 misc2;   // x = render W, y = render H, z,w reserved
    vec4  jitter;  // xy = current-frame jitter in render pixels
} pc;

// Bilinear fetch of the render-res colour at a continuous render-pixel coordinate,
// clamped to the valid [0,RW)x[0,RH) sub-rectangle.
vec3 sampleColor(vec2 rf, ivec2 rdim)
{
    vec2  f  = clamp(rf, vec2(0.0), vec2(rdim) - 1.0);
    ivec2 i0 = ivec2(floor(f));
    ivec2 i1 = min(i0 + 1, rdim - 1);
    vec2  t  = f - vec2(i0);
    vec3 c00 = imageLoad(inColor, ivec2(i0.x, i0.y)).rgb;
    vec3 c10 = imageLoad(inColor, ivec2(i1.x, i0.y)).rgb;
    vec3 c01 = imageLoad(inColor, ivec2(i0.x, i1.y)).rgb;
    vec3 c11 = imageLoad(inColor, ivec2(i1.x, i1.y)).rgb;
    return mix(mix(c00, c10, t.x), mix(c01, c11, t.x), t.y);
}

// Bilinear fetch of the display-res history at a continuous display-pixel coordinate.
vec3 sampleHist(uint slot, vec2 df, ivec2 ddim)
{
    vec2  f  = clamp(df, vec2(0.0), vec2(ddim) - 1.0);
    ivec2 i0 = ivec2(floor(f));
    ivec2 i1 = min(i0 + 1, ddim - 1);
    vec2  t  = f - vec2(i0);
    vec3 c00 = imageLoad(hist[slot], ivec2(i0.x, i0.y)).rgb;
    vec3 c10 = imageLoad(hist[slot], ivec2(i1.x, i0.y)).rgb;
    vec3 c01 = imageLoad(hist[slot], ivec2(i0.x, i1.y)).rgb;
    vec3 c11 = imageLoad(hist[slot], ivec2(i1.x, i1.y)).rgb;
    return mix(mix(c00, c10, t.x), mix(c01, c11, t.x), t.y);
}

void main()
{
    ivec2 d    = ivec2(gl_GlobalInvocationID.xy);
    ivec2 ddim = ivec2(pc.misc.y,  pc.misc.z);
    ivec2 rdim = ivec2(pc.misc2.x, pc.misc2.y);
    if (d.x >= ddim.x || d.y >= ddim.y) return;
    uint cur = pc.misc.x, prev = cur ^ 1u;

    // Display pixel -> continuous render-space coordinate. (RW/DW, RH/DH) is the
    // render pixels covered per display pixel; 1.0 when the scale is 100% (TAA only).
    vec2 scale = vec2(rdim) / vec2(ddim);
    vec2 rf    = (vec2(d) + 0.5) * scale - 0.5;

    // Current sample: un-jitter (the primary ray was offset by pc.jitter render px,
    // so the scene content of render pixel rf actually sits at rf - jitter).
    vec3 cur_c = sampleColor(rf - pc.jitter.xy, rdim);

    // 3x3 neighbourhood colour AABB around the nearest render pixel — the clamp box
    // that keeps reprojected history from ghosting across edges / disocclusions.
    ivec2 ri = clamp(ivec2(floor(rf + 0.5)), ivec2(0), rdim - 1);
    vec3  cmin = cur_c, cmax = cur_c;
    for (int dy = -1; dy <= 1; dy++)
    for (int dx = -1; dx <= 1; dx++) {
        ivec2 s = clamp(ri + ivec2(dx, dy), ivec2(0), rdim - 1);
        vec3  c = imageLoad(inColor, s).rgb;
        cmin = min(cmin, c);
        cmax = max(cmax, c);
    }

    // Motion: where this render pixel sat last frame (current -> previous, render px),
    // then map render-space -> display-space history coordinate.
    vec2 mv    = imageLoad(inMotion, ri).xy;
    vec2 prevR = vec2(ri) + mv;
    vec2 prevD = (prevR + 0.5) / scale - 0.5;

    vec3 outC;
    if (prevD.x >= 0.0 && prevD.y >= 0.0 &&
        prevD.x <= float(ddim.x - 1) && prevD.y <= float(ddim.y - 1)) {
        vec3 h = sampleHist(prev, prevD, ddim);
        h = clamp(h, cmin, cmax);          // neighbourhood-clamp = anti-ghosting
        outC = mix(h, cur_c, 0.1);         // history-weighted blend (~10-frame tail)
    } else {
        outC = cur_c;                      // no valid history -> current sample
    }

    if (any(isnan(outC)) || any(isinf(outC))) outC = cur_c;
    imageStore(hist[cur], d, vec4(outC, 1.0));
    imageStore(outColor,  d, vec4(outC, 1.0));
}
