#version 460
//
// DOOM-0009 path tracer — build step 6-d: temporal anti-aliasing upsampler (TAAU),
// phase 1. The final stage of the mode-6 denoised path: it takes the denoised image
// the SVGF composite produced at RENDER resolution (a sub-rectangle of the storage
// images when the render scale is below 100%) and reconstructs a full DISPLAY-
// resolution image by accumulating successive sub-pixel-jittered frames, reprojected
// through the per-pixel motion vectors.
//
// This is the custom upscaler the spec's §4.4 names first; FSR 2 / FSR 3.1 are later
// phases that consume the SAME contract (a render-res colour + motion-vector pair, a
// per-frame jitter, and a display-res history/output), so the plumbing is built once
// here. Phase 1 is a compact, recognised TAAU: Catmull-Rom current sample (un-jittered),
// motion-reprojected history, a 3x3 neighbourhood colour clamp to suppress ghosting,
// and a history-weighted blend. Variance clipping / depth-aware disocclusion are a
// later refinement (tuning rides the step-7 perf pass).
//
// Colour is the composite's tonemapped LDR sRGB output (rgba8); accumulating in that
// space is the simple-TAA convention and adequate for phase 1 — a linear/HDR tap
// point is an option an FSR backend may prefer, behind the same resource contract.
//
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba8) uniform readonly  image2D inColor;   // render-res denoised
layout(set = 0, binding = 1, rg16f) uniform readonly  image2D inMotion;  // render-res cur->prev px
layout(set = 0, binding = 2, rgba16f) uniform image2D hist[2];           // display-res history
layout(set = 0, binding = 3, rgba8) uniform writeonly image2D outColor;  // display-res output

layout(push_constant) uniform PC {
    uvec4 misc;    // x = cur parity, y = display W, z = display H, w = 1: RCAS writes the output
    uvec4 misc2;   // x = render W, y = render H, z,w reserved
    vec4  jitter;  // xy = current-frame jitter in render pixels
} pc;

// Catmull-Rom (4x4) fetch of the render-res colour at a continuous render-pixel
// coordinate, clamped to the valid [0,RW)x[0,RH) sub-rectangle. DOOM-0595: bilinear
// averaged each jittered sample with its neighbours, so the accumulated image settled
// on a blur of the render grid. Measured at 50 % scale vs a 100 % reference: edge
// energy 0.71 -> 0.74 of the reference, +0.2-0.3 dB, flicker +0.01, TAAU +0.01 ms at
// 4270x2000 (nearest was as sharp but flickered more; a Gaussian splat was softer).
// The caller clamps the overshoot to the 3x3 box, so the negative lobes cannot ring.
const float kInstMoveOff = 0.5;   // display px/frame at which the luma-instability term is off

vec3 sampleColor(vec2 rf, ivec2 rdim)
{
    vec2  f  = clamp(rf, vec2(0.0), vec2(rdim) - 1.0);
    ivec2 i0 = ivec2(floor(f));
    vec2  t  = f - vec2(i0);
    vec2  t2 = t * t, t3 = t2 * t;
    vec2  w[4] = vec2[4](-0.5 * t3 + t2 - 0.5 * t,
                          1.5 * t3 - 2.5 * t2 + 1.0,
                         -1.5 * t3 + 2.0 * t2 + 0.5 * t,
                          0.5 * t3 - 0.5 * t2);
    vec3 acc = vec3(0.0);
    for (int y = 0; y < 4; y++)
    for (int x = 0; x < 4; x++)
        acc += imageLoad(inColor, clamp(i0 + ivec2(x - 1, y - 1), ivec2(0), rdim - 1)).rgb
             * (w[x].x * w[y].y);
    return acc;
}

// Bilinear fetch of the display-res history at a continuous display-pixel coordinate.
// .a is the luma of the frame that wrote it (DOOM-0595 luma-instability term).
vec4 sampleHist(uint slot, vec2 df, ivec2 ddim)
{
    vec2  f  = clamp(df, vec2(0.0), vec2(ddim) - 1.0);
    ivec2 i0 = ivec2(floor(f));
    ivec2 i1 = min(i0 + 1, ddim - 1);
    vec2  t  = f - vec2(i0);
    vec4 c00 = imageLoad(hist[slot], ivec2(i0.x, i0.y));
    vec4 c10 = imageLoad(hist[slot], ivec2(i1.x, i0.y));
    vec4 c01 = imageLoad(hist[slot], ivec2(i0.x, i1.y));
    vec4 c11 = imageLoad(hist[slot], ivec2(i1.x, i1.y));
    return mix(mix(c00, c10, t.x), mix(c01, c11, t.x), t.y);
}

void main()
{
    ivec2 d    = ivec2(gl_GlobalInvocationID.xy);
    ivec2 ddim = ivec2(pc.misc.y,  pc.misc.z);
    ivec2 rdim = ivec2(pc.misc2.x, pc.misc2.y);
    if (d.x >= ddim.x || d.y >= ddim.y) return;
    uint cur = pc.misc.x, prev = cur ^ 1u;

    // Display pixel -> continuous render-space coordinate. (RW/DW, RH/DH) is the
    // render pixels covered per display pixel; 1.0 when the scale is 100% (TAA only).
    vec2 scale = vec2(rdim) / vec2(ddim);
    vec2 rf    = (vec2(d) + 0.5) * scale - 0.5;

    // Current sample: un-jitter (the primary ray was offset by pc.jitter render px,
    // so the scene content of render pixel rf actually sits at rf - jitter).
    vec3 cur_c = sampleColor(rf - pc.jitter.xy, rdim);

    // 3x3 neighbourhood colour AABB around the nearest render pixel — the clamp box
    // that keeps reprojected history from ghosting across edges / disocclusions.
    ivec2 ri = clamp(ivec2(floor(rf + 0.5)), ivec2(0), rdim - 1);
    vec3  cmin = vec3(1e30), cmax = vec3(-1e30);   // the 9 taps only, so the clamp below bites
    const vec3 kY = vec3(0.25, 0.5, 0.25);           // YCoCg luma
    float lsum = 0.0, lsq = 0.0;
    for (int dy = -1; dy <= 1; dy++)
    for (int dx = -1; dx <= 1; dx++) {
        ivec2 s = clamp(ri + ivec2(dx, dy), ivec2(0), rdim - 1);
        vec3  c = imageLoad(inColor, s).rgb;
        cmin = min(cmin, c);
        cmax = max(cmax, c);
        float l = dot(c, kY);
        lsum += l;  lsq += l * l;
    }
    // This frame's luma, quantised to 8 bits as FSR 2 does, so the rgba8 input's
    // rounding cannot read as instability.
    float lumaNow = round(lsum / 9.0 * 255.0) / 255.0;
    float lumaStd = sqrt(max(lsq / 9.0 - (lsum / 9.0) * (lsum / 9.0), 0.0));
    cur_c = clamp(cur_c, cmin, cmax);       // Catmull-Rom overshoot

    // Motion: where the surface under this DISPLAY pixel sat last frame, in display px.
    // The nearest render pixel's vector is applied at d itself, not at that render
    // pixel's centre: (ri + mv) mapped to display space snapped every display pixel
    // inside one render pixel onto the same history point -- at 50 % scale, pixel
    // pairs read one averaged history value every frame, blurring the reconstruction
    // back to render resolution. And the composite measures mv from the JITTERED ray
    // (prev projection - p, where the ray went through p + jitter), while the history
    // is stored un-jittered, so the jitter comes off: a static camera reads history at
    // exactly d instead of resampling it at a fresh sub-pixel offset each frame.
    // Sky and failed reprojections are written as exactly zero, which was never
    // measured from the jittered ray: they keep history at d itself.
    vec2 mv    = imageLoad(inMotion, ri).xy;
    vec2 jit   = (mv == vec2(0.0)) ? vec2(0.0) : pc.jitter.xy;
    vec2 prevD = vec2(d) + (mv - jit) / scale;

    vec3 outC;
    if (prevD.x >= 0.0 && prevD.y >= 0.0 &&
        prevD.x <= float(ddim.x - 1) && prevD.y <= float(ddim.y - 1)) {
        vec4 h4 = sampleHist(prev, prevD, ddim);
        vec3 h  = h4.rgb;
        float speed = length(prevD - vec2(d));
        // DOOM-0595: FSR 2's luma-instability term (ffx_fsr2_accumulate.h). Where this
        // frame's luma has swung back toward an older frame's, past the last frame's,
        // the pixel is flipping with the jitter: clamping its history to this frame's
        // box would hand the flip straight to the output, so keep history unclamped.
        // FSR keeps four frames; the spare history alpha gives two: N-1 reprojected
        // from hist[prev], N-2 from hist[cur] at d before this pass overwrites it, so
        // only where the motion rounds to zero (each invocation reads its own pixel).
        // Gated off by motion, where unclamped history would ghost. Only pixels the
        // clamp moves pay for the N-2 read (+0.2 ms at 4270x2000 when every pixel did).
        vec3  hc = clamp(h, cmin, cmax);
        float inst = 0.0;
        vec2  prevD2 = 2.0 * prevD - vec2(d);
        float l1 = h4.a, d0 = lumaNow - l1;
        if (hc != h && all(equal(ivec2(floor(prevD2 + 0.5)), d)) && abs(d0) >= 1.0 / 255.0) {
            float l2 = imageLoad(hist[cur], d).a, d1 = lumaNow - l2;
            bool  flip = l2 != 0.0 && sign(d1) == sign(d0) && abs(d1) < abs(d0);
            inst = (flip && clamp(lumaStd / 0.1, 0.0, 1.0) > 1.0 / 255.0) ? 1.0 : 0.0;
            inst *= 1.0 - clamp(speed / kInstMoveOff, 0.0, 1.0);
        }
        h = mix(hc, h, inst);              // neighbourhood-clamp = anti-ghosting
        // DOOM-0595: weight this frame by how near its jittered sample landed to d.
        // A fixed 0.1 averaged every jitter phase equally, which re-blurred the result
        // to render resolution whatever the filter. The nearest sample sits at render
        // index rn + jitter. On a still pixel the peak is FSR 2's 1/12 (0.2 let each
        // frame's noise through: flicker -36 % close, -44 % far at 50 % scale); the
        // longer memory then needs the narrower kernel (0.01 of the peak one display
        // pixel off) or it averages off-pixel phases into the edges. The floor keeps a
        // pixel no sample lands on from going stale. The peak rises back to 0.2 as the
        // surface moves (full at kMoveFull display px per frame), where a long history
        // would smear.
        const float kStill = 1.0 / 12.0, kMove = 0.2, kMoveFull = 2.0;
        float peak  = mix(kStill, kMove, clamp(speed / kMoveFull, 0.0, 1.0));
        ivec2 rn = clamp(ivec2(floor(rf - pc.jitter.xy + 0.5)), ivec2(0), rdim - 1);
        vec2  dd = (vec2(rn) + 0.5 + pc.jitter.xy) / scale - 0.5 - vec2(d);
        float a  = clamp(peak * exp(-4.58 * dot(dd, dd)), 0.02 * peak, peak);
        outC = mix(h, cur_c, a);
    } else {
        outC = cur_c;                      // no valid history -> current sample
    }

    if (any(isnan(outC)) || any(isinf(outC))) outC = cur_c;
    imageStore(hist[cur], d, vec4(outC, lumaNow));
    if (pc.misc.w == 0u) imageStore(outColor, d, vec4(outC, 1.0));   // else DOOM-0599 RCAS does
}
