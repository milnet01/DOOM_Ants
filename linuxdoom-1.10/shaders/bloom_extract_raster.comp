#version 450
//
// DOOM-0331 L2 (spec 4.2) — the rasterised chain's bright pass. Reads the same three scene
// targets composite.frag reads, recombines them through the SHARED include so the value
// thresholded is the value the screen will show, applies a soft-knee threshold, and writes
// the excess into the half-res bloomImage[0].
//
// Compute, not a fragment pass: dispatches cannot be recorded inside a render pass, and
// this runs between the SSAO pass and the swapchain pass. Having no vUV varying is why the
// include takes the sample coordinate as a parameter - this shader derives its own.
//
layout(local_size_x = 8, local_size_y = 8) in;

// Bindings 0/1/2 mirror composite.frag's set exactly (AMBIENT, DIRECT, half-res AO), all
// through the linear+clamp composite sampler. Binding 3 is the half-res bloom target.
layout(set = 0, binding = 0) uniform sampler2D ambientTex;
layout(set = 0, binding = 1) uniform sampler2D directTex;
layout(set = 0, binding = 2) uniform sampler2D aoTex;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D bloomOut;

// threshold and knee come from kBloomPresets in r_vulkan.cpp (INV-8) - never a literal here.
layout(push_constant) uniform Push {
    vec2  uvScale;
    float aoEnable;
    float threshold;
    float knee;
    float chainScale;
} pc;

#include "formulas/scene_recombine.glsl"

void main()
{
    ivec2 px  = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz  = imageSize(bloomOut);
    if (px.x >= sz.x || px.y >= sz.y)
        return;

    // 4.2 — which source texels sit under one output texel. The world fills only the
    // [0,uvScale] corner of a full-size scene target and this target is half the display,
    // so the ratio is 2*uvScale per axis: 1 at the shipped 50% render scale, 2 at 100%.
    // The intermediate scales give a fractional ratio - round UP, so a tap is duplicated
    // rather than a source texel missed. Derived, never hardcoded 2x2.
    // Exact texel reads, the same shape as bloom_extract_rt.comp (DOOM-0409): a filtered
    // read at a fractional ratio lands between texel centres and averages before the
    // threshold, which 4.2 forbids.
    ivec2 srcSz = textureSize(directTex, 0);
    vec2  ratio = pc.uvScale * vec2(srcSz) / vec2(sz);   // world texels / output texels
    ivec2 taps  = max(ivec2(1), ivec2(ceil(ratio - 1e-3)));
    ivec2 base  = ivec2(vec2(px) * ratio);
    ivec2 hi    = ivec2(pc.uvScale * vec2(srcSz)) - ivec2(1);

    // Threshold EACH source texel and average AFTER (4.2). Averaging first would dilute a
    // lone bright texel below the threshold and lose thin emitters - a distant lamp, a lit
    // switch - which is exactly what a bilinear fetch cannot avoid.
    vec3 sum = vec3(0.0);
    for (int j = 0; j < taps.y; ++j)
    for (int i = 0; i < taps.x; ++i)
    {
        // The source texel, clamped into the world corner, and its centre as a full-frame
        // coordinate for the AO read.
        ivec2 t  = min(base + ivec2(i, j), hi);
        vec2  uv = (vec2(t) + 0.5) / (pc.uvScale * vec2(srcSz));

        SceneParts sp = sceneRecombineParts(texelFetch(ambientTex, t, 0).rgb,
                                            texelFetch(directTex, t, 0), aoTex, uv, pc.aoEnable);
        vec3  c    = sp.direct + sp.ambient;
        // The non-finite guard lives in sceneRecombineParts (DOOM-0408), so sp.direct and
        // sp.ambient arrive here already finite -- zeroed together when either was not.
        // It used to sit in this pass alone, on the claim that nothing else read the
        // unguarded values; composite.frag reads the same three targets.
        // Soft knee so a surface crossing the threshold ramps in rather than pops.
        // peak, NOT Rec.709 luminance: luminance weights green at 0.7152 and red at
        // 0.2126, so a red fireball at four times white scores 0.85 and would not bloom
        // while a white wall sits on the threshold (4.2's table). peak is also what
        // pbrNeutralToneMapping keys its own compression on, so the threshold and the
        // operator's knee end up measured in the same units.
        // DOOM-0331 10 Q3 / DOOM-0345 INV-8 -- chainScale carries this chain's radiance
        // into the ray-traced chain's units so ONE threshold/knee pair means the same
        // thing on both. It is one of the TWO named per-chain constants the measurement
        // called for -- INV-8 anticipated one, and one cannot do it; the other is the
        // gain at the combine (r_vulkan.cpp, kBloomRasterGain), which carries the
        // magnitude. Still not a second preset table, which is what INV-8 rules out.
        // It multiplies the peak alone, never the extracted colour:
        // the weight below is unitless, so the halo stays in this chain's own units and
        // the scale decides WHAT blooms rather than how brightly it does.
        //
        // DOOM-0331 10 Q2 -- and it multiplies the DIRECT term alone, not the sum.
        // Scaling the sum is arithmetically a DIVISION of every preset's ramp start:
        // at chainScale 1.5, Medium's 1.15 becomes 0.767, below paper-white, and INV-4's
        // floor is gone. Measured 2026-08-21: a plain STARTAN3 wall at sector light 255
        // with no emitter in frame bloomed across 15.9 % of pixels on this chain while
        // both traced arms read 0.0 %. 4.2 draws the line this arithmetic has to respect
        // -- the ramp start bounds AMBIENT, which is sector light plus a GI bounce and
        // tops out near paper-white, while DIRECT is unbounded BY DESIGN and INV-4 says
        // outright that a heavily point-lit wall is expected to bloom. So the unit
        // conversion belongs on the term whose units actually differ between the chains.
        vec3  pk   = sp.direct * pc.chainScale + sp.ambient;
        float peak = max(pk.r, max(pk.g, pk.b));
        float soft = clamp(peak - pc.threshold + pc.knee, 0.0, 2.0 * pc.knee);
        soft       = soft * soft / (4.0 * pc.knee + 1e-4);
        float w    = max(soft, peak - pc.threshold) / max(peak, 1e-4);
        // DOOM-0331 INV-9 -- the sky never GENERATES bloom, and this states it rather
        // than leaving it to arithmetic. INV-9 held because a sky texel's DIRECT is a
        // palette colour that cannot exceed 1.0 and so could not reach a ramp start of
        // 1.15; a per-chain scale on that term reaches it at 1.5, so the invariant would
        // ride on whatever chainScale happens to be. mesh.frag writes the sky as
        // outDirect = vec4(skyOut, 100000.0) with outAmbient = 0, and ssao.frag already
        // reads that same far depth at >= 50000.0 to skip it. DOOM-0345 INV-5 is the
        // precedent: the RT extract multiplies its own sky flag in for this reason.
        // Generation only -- INV-9 keeps the combine free of any sky test, so a lamp
        // beside a sky edge still bleeds its halo onto the backdrop.
        if (sp.viewZ >= 50000.0)
            w = 0.0;
        sum += c * w;
    }

    imageStore(bloomOut, px, vec4(sum / float(taps.x * taps.y), 1.0));
}
