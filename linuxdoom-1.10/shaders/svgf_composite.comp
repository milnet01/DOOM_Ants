#version 460
//
// DOOM-0009 path tracer — build step 6a: SVGF composite (final pass).
//
// Re-modulates the denoised, albedo-demodulated illumination by the stored
// surface albedo, re-adds crisp self-emission (never denoised, so light sources
// stay sharp), then tonemaps with the SAME exposure -> Khronos PBR-Neutral ->
// sRGB operator as the live mode-4 path and writes the swapchain-bound storage
// image the present path blits. Sky pixels carry their stored linear colour
// straight through the tonemap.
//
#extension GL_EXT_buffer_reference     : require
#extension GL_EXT_scalar_block_layout  : require
#extension GL_GOOGLE_include_directive : require

#include "formulas/formulas.glsl"
#include "formulas/pbr_neutral_tonemap.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba32f) uniform image2D gpos[2];    // .w = matId (<0 sky)
layout(set = 0, binding = 2, rgba16f) uniform image2D galbedo;    // surface albedo
layout(set = 0, binding = 6, rgba16f) uniform image2D atrous[2];  // denoised illum
layout(set = 0, binding = 7, rgba8)   uniform image2D outColor;   // swapchain blit source
layout(set = 0, binding = 8, rg16f)   uniform writeonly image2D motion;  // 6-d motion vector
// DOOM-0011 L1: half-res fog target (binding 9, chosen in pathtrace.comp — reused by
// L4/L5/L6). rgb = inscatter (linear radiance), a = transmittance. READ side; the
// megakernel (pathtrace.comp, set 2) is the WRITE side of this same binding.
layout(set = 0, binding = 9, rgba16f) uniform image2D fogImg;

// Per-material Le table (3 floats/material, linear RGB), same buffer the trace
// reads for self-emission — passed by device address so the composite needs no
// material descriptor set.
layout(buffer_reference, scalar) readonly buffer MatEmis { float m[]; };

layout(push_constant) uniform PC {
    vec4  prevPos; vec4 prevDir; vec4 prevRight; vec4 prevUp;
    uvec4 misc;   // x = cur parity, y = width, z = height, w = final a-trous source index
    uvec4 misc2;
    uvec4 misc3;  // x = exposure EV (bit-cast float); y = rb_fog gate (DOOM-0011,
                  // mirrors the megakernel's pc.misc6.z — 0 = fog off, INV-8)
    MatEmis matEmis;
} pc;

// DOOM-0011 L1: manual bilinear upsample of the half-res fog target to this composite
// pass's full-res pixel `p` (render-space — matches pathtrace.comp's `px`). Storage
// images have no hardware filtering, so this is 4 imageLoads + a lerp. NOTE: the
// megakernel's half-res gate is a POINT sample at each 2x2 block's even/even corner
// (px & ~1), not a block average, so texel j lands exactly at full-res index 2j —
// the texel-space coordinate is p/2 with NO pixel-centre offset (that offset formula
// is for box-averaged downsamples, which this isn't). Depth-guided (bilateral)
// upsample arrives at L5 (Q6); this is deliberately naive for L1.
vec4 fetchFogBilinear(ivec2 p)
{
    vec2  hf = vec2(p) * 0.5;
    ivec2 i0 = ivec2(floor(hf));
    vec2  f  = hf - vec2(i0);
    ivec2 lo = ivec2(0);
    ivec2 hi = imageSize(fogImg) - ivec2(1);
    vec4 c00 = imageLoad(fogImg, clamp(i0 + ivec2(0, 0), lo, hi));
    vec4 c10 = imageLoad(fogImg, clamp(i0 + ivec2(1, 0), lo, hi));
    vec4 c01 = imageLoad(fogImg, clamp(i0 + ivec2(0, 1), lo, hi));
    vec4 c11 = imageLoad(fogImg, clamp(i0 + ivec2(1, 1), lo, hi));
    return mix(mix(c00, c10, f.x), mix(c01, c11, f.x), f.y);
}

// DOOM-0096: the exposure EV is no longer a fixed constant — the host passes the
// user's Brightness-slider value (rb_exposure) in misc3.x (bit-cast float) so the
// Ultra/denoiser view brightness is adjustable from the Renderer menu.
vec3 toneEncode(vec3 L)
{
    float EXPOSURE_EV = uintBitsToFloat(pc.misc3.x);
    L = max(L, vec3(0.0)) * exposureEv(EXPOSURE_EV);
    L = pbrNeutralToneMapping(L);
    return vec3(linearToSrgb(L.r), linearToSrgb(L.g), linearToSrgb(L.b));
}

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    int   w = int(pc.misc.y), h = int(pc.misc.z);
    if (p.x >= w || p.y >= h) return;
    uint cur = pc.misc.x, fin = pc.misc.w;

    vec4 gp    = imageLoad(gpos[cur], p);
    vec3 illum = imageLoad(atrous[fin], p).rgb;

    // DOOM-0141: sky backdrop (matId < 0). gillum carries the DISPLAY-encoded sky
    // panorama (the mountains), passed through the denoiser untouched; emit it raw —
    // fullbright, NO tonemap — so the denoised sky matches the Solid/raster sky exactly
    // (which writes the palette colour straight to the swapchain). Motion is zero for a
    // view-locked backdrop (recomputed each frame, so no reprojection/ghosting).
    if (gp.w < 0.0) {
        vec3 sky = illum;
        if (any(isnan(sky)) || any(isinf(sky))) sky = vec3(0.0);
        // DOOM-0011 L1: the sky is stored DISPLAY-encoded/fullbright (deliberately not
        // tonemapped, above) — treat it as linear for the fold, then re-clamp, so fog
        // matches at the sky/wall seam where shafts read (§4.6/Q9). rb_fog==0 -> fog.a=1,
        // fog.rgb=0 -> sky*1+0 == sky, a byte-identical no-op.
        if (pc.misc3.y != 0u) {
            // DOOM-0011 Q24b: `sky` is DISPLAY-encoded but fog.rgb is LINEAR radiance, so
            // folding them directly showed the same fog ~2.5x darker here than on a wall,
            // inverting aerial perspective at the very seam this fold exists to match.
            // Decode, fold in linear exactly as the surface path does, re-encode.
            vec4 fog = fetchFogBilinear(p);
            vec3 skyLin = vec3(srgbToLinear(sky.r), srgbToLinear(sky.g), srgbToLinear(sky.b));
            sky = toneEncode(skyLin * fog.a + fog.rgb);   // fog in front of visible sky
        }
        imageStore(outColor, p, vec4(clamp(sky, 0.0, 1.0), 1.0));
        imageStore(motion, p, vec4(0.0));
        return;
    }

    vec3 L;
    {
        vec4 ga = imageLoad(galbedo, p);
        vec3 albedo = ga.rgb;
        uint id = uint(gp.w + 0.5);
        vec3 emis = vec3(pc.matEmis.m[id * 3u + 0u],
                         pc.matEmis.m[id * 3u + 1u],
                         pc.matEmis.m[id * 3u + 2u]);
        // DOOM-0084: localise self-emission to this texel's VALUE (max channel, so a
        // saturated red/blue light isn't suppressed) — a lamp glows from its lit top,
        // not its dark stand — matching shadeSurface() in pt_common.glsl so the
        // denoised view agrees with the raw mode-4 view. ga.a is the emission ENABLE
        // (0 for a non-light sprite — pickup/monster). INV-7 backfill thresholds.
        float emisMask = smoothstep(0.30, 0.60, max(albedo.r, max(albedo.g, albedo.b)));
        L = albedo * illum + emis * emisMask * ga.a;
    }
    // DOOM-0011 L1: fog is a SEPARATE channel, folded AFTER the albedo re-multiply
    // above (it has no surface albedo of its own) and BEFORE the tonemap, in linear
    // radiance (§4.6). rb_fog==0 -> fog.a=1, fog.rgb=0 -> exact no-op (INV-8).
    if (pc.misc3.y != 0u) {
        vec4 fog = fetchFogBilinear(p);                 // half-res -> full-res, plain bilinear (L1)
        L = L * fog.a + fog.rgb;                        // linear, before tonemap (§4.6)
    }
    if (any(isnan(L)) || any(isinf(L))) L = vec3(0.0);
    imageStore(outColor, p, vec4(toneEncode(L), 1.0));

    // Motion vector (build step 6-d): where this pixel's world point sat in the
    // PREVIOUS frame, as a displacement in render pixels (current -> previous). The
    // temporal upscaler (TAAU now; FSR later, same contract) reprojects its history
    // by this. Reuses the prev-camera basis already in this pass's push constants —
    // the exact inverse of pathtrace.comp's pixel-centre ray construction, matching
    // the svgf_temporal reprojection. Sky / behind-camera writes zero (no motion ->
    // the upscaler keeps the current sample).
    vec2 mv = vec2(0.0);
    if (gp.w >= 0.0) {
        vec3  rel = gp.xyz - pc.prevPos.xyz;
        float vz  = dot(rel, pc.prevDir.xyz);
        if (vz > 1e-3) {
            float ndcX =  (dot(rel, pc.prevRight.xyz) / vz) / pc.prevRight.w;
            float ndcY = -(dot(rel, pc.prevUp.xyz)    / vz) / pc.prevUp.w;
            float fx = (ndcX + 1.0) * 0.5 * float(w) - 0.5;
            float fy = (ndcY + 1.0) * 0.5 * float(h) - 0.5;
            mv = vec2(fx, fy) - vec2(p);
        }
    }
    imageStore(motion, p, vec4(mv, 0.0, 0.0));
}
