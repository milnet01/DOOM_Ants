#version 460
//
// DOOM-0599: robust contrast-adaptive sharpening (RCAS) after the traced view's TAAU.
// Our own GLSL of the algorithm AMD published as FsrRcasF in FidelityFX ffx_fsr1.h
// (MIT). It reads this frame's TAAU history (full-precision display-res output) and
// writes the display output; the history itself stays unsharpened, so the gain never
// feeds back into accumulation.
//
// For each pixel e with cross neighbours b, d, f, h it solves for the largest negative
// lobe that keeps e's result inside [0,1] given the cross's min and max (the halo
// limit), caps it at FSR_RCAS_LIMIT, scales it by exp2(-stops), and halves it where
// e differs from its cross average by most of the local range (isolated noise).
//
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 2, rgba16f) uniform readonly  image2D hist[2];   // TAAU history
layout(set = 0, binding = 3, rgba8)   uniform writeonly image2D outColor;  // display output

layout(push_constant) uniform PC {
    uvec4 misc;    // x = cur parity, y = display W, z = display H, w unused
    uvec4 misc2;   // unused (TaauPC layout, shared pipeline layout)
    vec4  jitter;  // z = sharpness scale exp2(-stops)
} pc;

const float kRcasLimit = 0.25 - 1.0 / 16.0;

float max3(vec3 v) { return max(v.x, max(v.y, v.z)); }

void main()
{
    ivec2 p    = ivec2(gl_GlobalInvocationID.xy);
    ivec2 ddim = ivec2(pc.misc.y, pc.misc.z);
    if (p.x >= ddim.x || p.y >= ddim.y) return;
    uint cur = pc.misc.x;

    vec3 e = imageLoad(hist[cur], p).rgb;
    vec3 b = imageLoad(hist[cur], clamp(p + ivec2( 0, -1), ivec2(0), ddim - 1)).rgb;
    vec3 d = imageLoad(hist[cur], clamp(p + ivec2(-1,  0), ivec2(0), ddim - 1)).rgb;
    vec3 f = imageLoad(hist[cur], clamp(p + ivec2( 1,  0), ivec2(0), ddim - 1)).rgb;
    vec3 h = imageLoad(hist[cur], clamp(p + ivec2( 0,  1), ivec2(0), ddim - 1)).rgb;

    // Luma times 2, as FSR's noise detector uses it.
    float bL = b.b * 0.5 + (b.r * 0.5 + b.g), dL = d.b * 0.5 + (d.r * 0.5 + d.g);
    float eL = e.b * 0.5 + (e.r * 0.5 + e.g), fL = f.b * 0.5 + (f.r * 0.5 + f.g);
    float hL = h.b * 0.5 + (h.r * 0.5 + h.g);
    float nz = 0.25 * (bL + dL + fL + hL) - eL;
    float range = max(max(max(bL, dL), max(eL, fL)), hL) - min(min(min(bL, dL), min(eL, fL)), hL);
    nz = clamp(abs(nz) / max(range, 1e-5), 0.0, 1.0);
    nz = -0.5 * nz + 1.0;

    vec3 mn4 = min(min(b, d), min(f, h));
    vec3 mx4 = max(max(b, d), max(f, h));
    vec3 hitMin = min(mn4, e) / max(4.0 * mx4, vec3(1e-5));
    vec3 hitMax = (1.0 - max(mx4, e)) / min(4.0 * mn4 - 4.0, vec3(-1e-5));
    vec3 lobeRGB = max(-hitMin, hitMax);
    float lobe = max(-kRcasLimit, min(max3(lobeRGB), 0.0)) * pc.jitter.z * nz;

    vec3 c = (lobe * (b + d + f + h) + e) / (4.0 * lobe + 1.0);
    if (any(isnan(c))) c = e;
    imageStore(outColor, p, vec4(c, 1.0));
}
