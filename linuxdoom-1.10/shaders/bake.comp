#version 460
//
// DOOM-0009 path tracer — static GI bake (build step 4b-ii).
//
// DOOM's lighting is ~95% static, so the bounced (indirect) light is solved ONCE
// at level load instead of every frame. One compute thread per GI probe (on the
// DOOM-0652 B3 lattice, layout in light_grid.h): the thread
// fires BAKE_RAYS sample rays over the full sphere, shades each hit with the SAME
// NEE direct-lighting the camera frame uses (shadeSurface, pt_common.glsl), and
// projects the incoming radiance onto an SH-L1 (4-coefficient) directional basis.
// The result is written back into the probe buffer; the megakernel reads it in
// step 4c to replace the temporary flat ambient fill with a real bounce solution.
//
// This is single-bounce indirect: each probe sees the directly-lit (and self-
// emissive) surfaces around it. That is the first lit GI term; multi-bounce would
// iterate the probes feeding back into the bake (a later refinement).
//
#extension GL_EXT_ray_query              : require
#extension GL_EXT_buffer_reference       : require
#extension GL_EXT_scalar_block_layout    : require
#extension GL_EXT_nonuniform_qualifier   : require
#extension GL_GOOGLE_include_directive    : require   // shared pt_common.glsl

layout(local_size_x = 64) in;

// Same set 0 (TLAS) + set 1 (materials) the megakernel binds, so shadeSurface()
// traces the same scene and decodes the same DOOM palette. The bake writes no
// image — the probe buffer is its output, reached by GPU address (below).
layout(set = 0, binding = 0) uniform accelerationStructureEXT topAS;
layout(set = 1, binding = 0) uniform sampler2D paletteTex;
layout(set = 1, binding = 2) uniform sampler2D materialTex[];

#include "pt_common.glsl"

// The GI probe buffer (read-write by GPU address), laid out as light_grid.h says. The
// host wrote the header, index and positions; this pass fills each record's SH-L1
// radiance, its reach along the six axes, and its valid flag.
layout(buffer_reference, scalar) buffer Probes { float p[]; };

layout(push_constant) uniform PC {
    uvec4    misc;     // x = probeCount, y = numWall, z = emitterCount,
                       // w = giEnabled (1 on bounce passes 2+, reads prevProbes)
    Verts    verts;    // level mesh vertex buffer
    Emitters emit;     // step-3b emitter list (count in misc.z)
    MatEmis  matEmis;  // per-material Le table
    Probes   probes;   // GI probe buffer (this pass's output)
    ProbesRO prevProbes; // previous bounce pass's probes (read for multi-bounce)
    Probes   direct;    // DOOM-0652 B4: 12 SH floats per probe, the first pass's direct
                        // light; passes 2+ add it back instead of re-tracing it
    EmitSec  emitSec;  // DOOM-0119: unused here (always 0) — the bake's omni loop is
    Reject   reject;   // empty (omniStart == emitCount), so shadeSurface's REJECT cull
                       // is dead; passed only to satisfy the shared signature.
} pc;

const uint  BAKE_RAYS = 128u;   // sphere samples/probe. SH-L1 is very low frequency,
                                // and every probe casts the same directions (DOOM-0652
                                // B3), so what error is left varies smoothly across
                                // the lattice. The lattice holds tens of thousands of
                                // probes on the largest maps, so this sets load time.
const uint  BAKE_NEE  = 1u;     // shadow rays per bake-ray hit. 1 suffices — the
                                // sphere integration already averages over BAKE_RAYS
                                // directions, so per-hit direct-light variance washes
                                // out into the low-order SH.
// DOOM-0652 B3: a probe that sees more than this share of its rays land on the back of a
// surface sits inside solid map (the lattice is placed by sector, which cannot tell), and
// is marked invalid. A few back hits are normal: a two-sided middle texture has one face.
const float BAKE_BACK_MAX = 0.25;
const float BAKE_REACH_FAR = 1.0e4;   // reach along an axis that meets nothing

// Distance from P along d to the first world surface, BAKE_REACH_FAR if none.
float bakeReach(vec3 P, vec3 d)
{
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, topAS, gl_RayFlagsOpaqueEXT, 0x01u, P, 0.01, d, BAKE_REACH_FAR);
    while (rayQueryProceedEXT(rq)) {}
    return rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionTriangleEXT
         ? rayQueryGetIntersectionTEXT(rq, true) : BAKE_REACH_FAR;
}

void main()
{
    const uint pi = gl_GlobalInvocationID.x;
    if (pi >= pc.misc.x)
        return;

    const uint dims = uint(pc.probes.p[5]) * uint(pc.probes.p[6]) * uint(pc.probes.p[7]);
    const uint base = GI_PROBE_HDR + dims + pi * GI_PROBE_REC;
    const vec3 P = vec3(pc.probes.p[base + 0u], pc.probes.p[base + 1u], pc.probes.p[base + 2u]);

    // DOOM-0652 B4: passes 2+ cast the same rays to the same hits, so their direct light
    // is the first pass's. They take it from pc.direct and trace only the bounce. Reach and
    // the valid flag do not change either, so they are copied from the previous pass.
    const bool bounce = pc.misc.w != 0u;
    if (bounce)
    {
        for (uint k = 16u; k < 22u; k++)
            pc.probes.p[base + k] = pc.prevProbes.p[base + k];
        pc.probes.p[base + 3u] = pc.prevProbes.p[base + 3u];
        if (pc.prevProbes.p[base + 3u] == 0.0)
            return;                              // inside solid map: readers skip it
    }

    // SH-L1 radiance accumulators per colour channel (4 coeffs each: l=0 + 3*l=1).
    vec4 shR = vec4(0.0), shG = vec4(0.0), shB = vec4(0.0);
    uint backHits = 0u;

    for (uint s = 0u; s < BAKE_RAYS; s++)
    {
        // DOOM-0652 B3: seeded by ray index only, so every probe casts the same directions
        // and neighbours share their noise; a blend between them then shows no grain.
        uint seed = pcgHash(s * 9781u + 1u);
        // Uniform direction on the full sphere (z = 1 - 2u maps to cos-uniform).
        float u1 = rnd(seed), u2 = rnd(seed);
        float z   = 1.0 - 2.0 * u1;
        float r   = sqrt(max(0.0, 1.0 - z * z));
        float phi = 2.0 * PI * u2;
        vec3  wi  = vec3(r * cos(phi), r * sin(phi), z);

        // Trace the sample ray from the probe.
        rayQueryEXT rq;
        // Mask 0x01 = the static world instance only. The sky backdrop (0x04) and
        // sprite billboards (0x02) must NOT be committed here: this loop decodes
        // every hit through pc.verts (the world mesh), so a hit on either of the
        // other BLASes would read unrelated vertex data. Culling them lets a
        // sky-facing sample fall through to the miss path, which is where the sky
        // contributes its radiance.
        rayQueryInitializeEXT(rq, topAS, gl_RayFlagsOpaqueEXT, 0x01u, P, 0.01, wi, 1.0e9);
        while (rayQueryProceedEXT(rq)) {}

        vec3 Li;
        if (rayQueryGetIntersectionTypeEXT(rq, true)
            == gl_RayQueryCommittedIntersectionTriangleEXT)
        {
            // Flat-shaded hit-surface decode (mirrors the megakernel's primary
            // hit): non-indexed soup, 18 floats/vertex, vertex 0 of triangle prim
            // at prim*3*18. Normal faced toward the probe.
            const int  prim = rayQueryGetIntersectionPrimitiveIndexEXT(rq, true);
            const uint i0   = uint(prim) * 3u * 18u;
            vec3 n = normalize(vec3(pc.verts.v[i0 + 3u], pc.verts.v[i0 + 4u], pc.verts.v[i0 + 5u]));
            if (dot(n, wi) > 0.0) { n = -n; backHits++; }   // the mesh's normals face the air
            // DOOM-0652 B4: past the cap the probe is invalid whatever the other rays see,
            // so stop paying for them. Readers skip an invalid probe, so its SH can stay.
            if (!bounce && float(backHits) > BAKE_BACK_MAX * float(BAKE_RAYS))
            {
                pc.probes.p[base + 3u] = 0.0;
                return;
            }
            int   texnum = floatBitsToInt(pc.verts.v[i0 + 8u]);
            int   flags  = floatBitsToInt(pc.verts.v[i0 + 9u]);
            uint  id     = ((flags & FLAG_FLAT) != 0) ? (pc.misc.y + uint(texnum))
                                                      : uint(texnum);

            // Barycentric-interpolate the UV (flat-shaded normal, but per-vertex UVs)
            // so the bake reflects the same per-texel albedo the megakernel does —
            // pt_common is shared precisely so the two agree on what a surface
            // reflects. 18 floats/vertex, UV at [6,7]; v1 at +24, v2 at +42.
            vec2 bc = rayQueryGetIntersectionBarycentricsEXT(rq, true);
            vec2 uv = (1.0 - bc.x - bc.y) * vec2(pc.verts.v[i0 +  6u], pc.verts.v[i0 +  7u])
                    +          bc.x        * vec2(pc.verts.v[i0 + 24u], pc.verts.v[i0 + 25u])
                    +          bc.y        * vec2(pc.verts.v[i0 + 42u], pc.verts.v[i0 + 43u]);
            vec3  albedo = decodeAlbedo(id, uv);
            float tHit   = rayQueryGetIntersectionTEXT(rq, true);
            vec3  hitP   = P + wi * tHit;

            // Outgoing radiance from the hit toward the probe: NEE direct only
            // (addEmission=false — directly-visible emitters are the frame's NEE
            // job; folding them in here too would double-count). This pass's probes
            // therefore hold INDIRECT radiance.
            // omniStart = emitCount: the level-load bake has only static wall/flat
            // emitters (no sprite lights yet), so every emitter stays oriented.
            // DOOM-0119: hitSec 0xFFFFFFFF + numSectors 0 -> REJECT cull off (the bake
            // never culls; its omni loop is empty anyway).
            // DOOM-0103 INV-2: a zero view direction and setting 0, so the probes hold
            // no highlight; noSpec stays zero.
            // Multi-bounce: passes 2+ (giEnabled) take the light this surface received
            // from the PREVIOUS bounce's probes; pass 1's direct light is added after the
            // loop. Pass 1 builds 1-bounce indirect; pass 2 = 2 bounces, pass 3 = 3, etc.
            vec3 noSpec;
            if (bounce)
                Li = albedo * giIrradianceAt(pc.prevProbes, hitP, n);
            else
                Li = shadeSurface(hitP, n, albedo, id, pc.misc.z, pc.misc.z,
                                  pc.emit, pc.matEmis, BAKE_NEE, false,
                                  1.0,   // unused: addEmission is false for the bake
                                  0xFFFFFFFFu, 0u, pc.emitSec, pc.reject,
                                  vec3(0.0), 1.0, vec3(kSpecF0), 0u, 0u, noSpec, seed);
        }
        else
        {
            // Ray escaped through the sky: bounded sky-light fill. It is direct light, so
            // a bounce pass gets it back from pc.direct.
            Li = bounce ? vec3(0.0) : SKY_COLOR;
        }

        // The same non-finite guard pathtrace.comp applies to shadeSurface's result
        // (DOOM-0409). Here it matters more: one NaN sample poisons this probe's SH for
        // the whole level, and every pixel in the subsector reads it every frame.
        if (any(isnan(Li)) || any(isinf(Li))) Li = vec3(0.0);

        // Project incoming radiance onto the real SH-L1 basis for direction wi:
        //   Y00 = 0.282095, Y1m = 0.488603 * {y, z, x}
        vec4 Y = vec4(0.282095, 0.488603 * wi.y, 0.488603 * wi.z, 0.488603 * wi.x);
        shR += Li.r * Y;
        shG += Li.g * Y;
        shB += Li.b * Y;
    }

    // Monte-Carlo normalisation for uniform sphere sampling: integral estimate is
    // (4*pi / N) * sum. The clamped-cosine convolution for irradiance lookup is
    // applied later (step 4c), so the probe stores raw radiance SH coefficients.
    float norm = (4.0 * PI) / float(BAKE_RAYS);
    shR *= norm; shG *= norm; shB *= norm;

    const uint dbase = pi * 12u;
    if (bounce)
    {
        shR += vec4(pc.direct.p[dbase + 0u], pc.direct.p[dbase + 1u], pc.direct.p[dbase + 2u],  pc.direct.p[dbase + 3u]);
        shG += vec4(pc.direct.p[dbase + 4u], pc.direct.p[dbase + 5u], pc.direct.p[dbase + 6u],  pc.direct.p[dbase + 7u]);
        shB += vec4(pc.direct.p[dbase + 8u], pc.direct.p[dbase + 9u], pc.direct.p[dbase + 10u], pc.direct.p[dbase + 11u]);
    }
    else
    {
        pc.direct.p[dbase + 0u] = shR.x; pc.direct.p[dbase + 1u] = shR.y; pc.direct.p[dbase + 2u]  = shR.z; pc.direct.p[dbase + 3u]  = shR.w;
        pc.direct.p[dbase + 4u] = shG.x; pc.direct.p[dbase + 5u] = shG.y; pc.direct.p[dbase + 6u]  = shG.z; pc.direct.p[dbase + 7u]  = shG.w;
        pc.direct.p[dbase + 8u] = shB.x; pc.direct.p[dbase + 9u] = shB.y; pc.direct.p[dbase + 10u] = shB.z; pc.direct.p[dbase + 11u] = shB.w;
    }

    pc.probes.p[base + 4u]  = shR.x; pc.probes.p[base + 5u]  = shR.y;
    pc.probes.p[base + 6u]  = shR.z; pc.probes.p[base + 7u]  = shR.w;
    pc.probes.p[base + 8u]  = shG.x; pc.probes.p[base + 9u]  = shG.y;
    pc.probes.p[base + 10u] = shG.z; pc.probes.p[base + 11u] = shG.w;
    pc.probes.p[base + 12u] = shB.x; pc.probes.p[base + 13u] = shB.y;
    pc.probes.p[base + 14u] = shB.z; pc.probes.p[base + 15u] = shB.w;

    if (bounce)
        return;                                  // reach and valid were copied above

    // DOOM-0652 B3: the reach giIrradianceAt tests a point against, and the valid flag.
    pc.probes.p[base + 16u] = bakeReach(P, vec3( 1, 0, 0));
    pc.probes.p[base + 17u] = bakeReach(P, vec3(-1, 0, 0));
    pc.probes.p[base + 18u] = bakeReach(P, vec3( 0, 1, 0));
    pc.probes.p[base + 19u] = bakeReach(P, vec3( 0,-1, 0));
    pc.probes.p[base + 20u] = bakeReach(P, vec3( 0, 0, 1));
    pc.probes.p[base + 21u] = bakeReach(P, vec3( 0, 0,-1));
    pc.probes.p[base + 3u]  = (float(backHits) > BAKE_BACK_MAX * float(BAKE_RAYS)) ? 0.0 : 1.0;
}
