#version 460
//
// DOOM-0009 path tracer — build steps 2c/3a/3c.
//
// A compute megakernel that casts one primary ray per pixel against the level
// TLAS (built in step 2b) via VK_KHR_ray_query, and writes an image the present
// path blits to the swapchain. Modes 1-3 are diagnostics; mode 4 is the first
// real lit output. Selected by the host (the `~` debug toggle, off -> 1..4):
//
//   mode 1  INTERSECTION  — traversal + camera sanity. On a hit, colour by the
//                           surface normal (n*0.5+0.5); on a miss, a dark sky.
//                           Should line up face-for-face with the raster view.
//   mode 2  WHITE FURNACE  — energy sanity for the sampling math step 3 reuses.
//                           Every hit does one cosine-weighted diffuse bounce
//                           into a constant unit-radiance environment with
//                           albedo 1 and NO occlusion: the estimator
//                           brdf*cos/pdf = albedo = 1 exactly, with zero
//                           variance. So a correct integrator paints the whole
//                           screen flat white; any tint/banding is an energy
//                           bug in the pdf/throughput code.
//   mode 3  TEXTURED       — build step 3a: fetch the hit surface's real DOOM
//                           material (paletted texture decoded through PLAYPAL,
//                           exactly as the raster mesh.frag does) and modulate by
//                           sector lightlevel. The honest "albedo recovered +
//                           sector-light seed" view; real NEE direct lighting
//                           replaces the flat sector-light term in step 3c.
//   mode 4  NEE DIRECT    — build step 3c: linear albedo + the surface's own
//                           emission, plus direct light estimated by shadow-
//                           sampling the step-3b emitter list (hard ray-traced
//                           shadows), a flat sky ambient standing in for the
//                           step-4 GI bake, Reinhard-tonemapped. The first lit
//                           image: lamps/screens/slime/lit switches cast light.
//
#extension GL_EXT_ray_query              : require
#extension GL_EXT_buffer_reference       : require
#extension GL_EXT_scalar_block_layout    : require
#extension GL_EXT_nonuniform_qualifier   : require
#extension GL_GOOGLE_include_directive    : require   // shared pt_common.glsl

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT topAS;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D outImg;
// Float accumulation target for the INV-6 verify path (build step 4d, mode 5).
// Carries running sums: rgb = summed direct-only radiance, a = sample count. Read
// back on the host to form converged images. Untouched by the display modes 1-4.
layout(set = 0, binding = 2, rgba32f) uniform image2D accumImg;

// SVGF denoiser feed (set 2; DOOM-0009 build step 6). Mode 6 writes the G-buffer
// the temporal/a-trous/composite passes consume instead of a tonemapped pixel:
// world position+matId, world normal, surface albedo, and the noisy albedo-
// DEMODULATED illumination. gpos/gnorm ping-pong by frame parity (pc.misc3.w):
// mode 6 writes [cur]; the temporal pass reprojects last frame's [prev]. Only the
// feed half of the set is declared here (the denoiser passes declare the rest).
layout(set = 2, binding = 0, rgba32f) uniform writeonly image2D gpos[2];   // worldPos.xyz, .w = matId (<0 sky)
layout(set = 2, binding = 1, rgba16f) uniform writeonly image2D gnorm[2];  // world normal.xyz
layout(set = 2, binding = 2, rgba16f) uniform writeonly image2D galbedo;   // surface albedo.rgb
layout(set = 2, binding = 3, rgba16f) uniform writeonly image2D gillum;    // demodulated noisy illum
// DOOM-0011 L1: half-res fog target (binding 9 — chosen here, reused by L4/L5/L6).
// rgb = inscatter (linear radiance), a = transmittance. Megakernel WRITE side; the
// composite reads the same binding (svgf_composite.comp, set 0) as its READ side.
layout(set = 2, binding = 9, rgba16f) uniform writeonly image2D fogImg;

// Materials (set 1) — shared verbatim with the raster pass (r_vulkan.cpp
// CreateDescriptors / mesh.frag): the 256x1 PLAYPAL LUT and the bindless array of
// R8 palette-index material images. Same binding numbers (0, 2) and the same
// g.ds set bound at trace time, so the traced surface decodes to DOOM's exact
// colours with no parallel material path.
layout(set = 1, binding = 0) uniform sampler2D paletteTex;
layout(set = 1, binding = 2) uniform sampler2D materialTex[];

// DOOM-0042 HD PBR material set (set 3) — parallel to the paletted materialTex[].
// binding 0 = the per-material control table (usePBR flag, map-slot indices, uvScale);
// binding 1 = the bindless RGBA8 PBR map array. Built per level by EnsureHdMaterials
// (r_vulkan.cpp); InitHdDefault seeds an all-paletted set so set 3 is valid for every
// RT dispatch (the -rtverify path + the first frame) before a level's HD maps load.
struct MatCtrl {
    int   maps[7];    // [0]alb [1]nrm [2]rgh [3]met [4]ao [5]emis [6]hgt; -1 = none
    float uvScale;
    uint  flags;      // bit0 pom, bit1 noPom, bit2 sprite, bit3 nukage, bit4 lava (DOOM-0183)
    uint  usePBR;     // 0 = paletted fallback
};
layout(set = 3, binding = 0, std430) readonly buffer MatCtrlBuf { MatCtrl ctrl[]; };
layout(set = 3, binding = 1) uniform sampler2D hdTex[];   // bindless RGBA8 PBR maps

// The level mesh, the step-3b emitter list, and the per-material Le table are read
// by GPU address (buffer_reference). Their buffer layouts + the shared albedo
// decode and NEE direct-lighting math live in pt_common.glsl, #included verbatim
// by the GI bake (bake.comp) too, so the baked bounce and the directly-traced
// frame agree on what each surface reflects.
#include "pt_common.glsl"

// Tone pipeline (build step 4b-iii). The scalar curves come from the Vestige
// Formula Workbench export (exposureEv, linearToSrgb in formulas.glsl); the
// PBR-Neutral operator is the hand-written non-scalar routine. This retires the
// inline EXPOSURE=4.0 + Reinhard + pow(1/2.2) hack (INV-7 backfill paid down).
#include "formulas/formulas.glsl"
#include "formulas/pbr_neutral_tonemap.glsl"

// DOOM-0042: self-radiance scale for an HD emissive map (Task 13). Reused from
// emissive_derive.h:52; re-tune (lower) expected once a real emissive hero lands.
const float kEmissiveScale = 40.0;
// POM march depth (Task 14): the parallax offset spans at most this fraction of one UV tile.
const float kPomHeightScale = 0.06;
// DOOM-0179: world-space grime overlay tunables (the playtest knobs — rebuild to re-tune).
// One grime tile spans ~384 DOOM map units, so the pattern is LOW frequency vs the base
// texture (which repeats every 64-128 units): grime drifts across a whole wall and differs
// between adjacent walls at different world positions, breaking the visible tiling. Strength
// is the ± mottle depth of the centred blend (0 = off). The base heroes are pre-weathered,
// so keep this subtle — it ADDS variation, it isn't the primary dirt.
const float kGrimeWorldScale = 1.0 / 384.0;
const float kGrimeStrength    = 0.25;   // subtle large-scale brightness variation (grounding only)
// DOOM-0181 L4 "filth" rework: distinct, hard-edged, multi-coloured DIRT STAINS — not a soft wash.
// The old soft multiply could only fade, so it never read as dirt. Now a stain forms where the
// multi-scale grunge (grungeFbm) is darkest, and a NARROW smoothstep gives a defined edge. Each
// stain-region picks ONE colour from a small palette by a coarse world-cell hash, so a whole mark
// is one colour and neighbours differ: brown dirt / near-black soot on any surface; green goo only
// pools on floors. Applied to ALL world surfaces in the Ultra RT view (paletted included) so dirt
// shows everywhere — never on sprites. The crevice term still darkens genuine recesses (INV-7);
// darkening stays inside applyGrime's clamp(0.35,1.65) ceiling (INV-6).
const float kGrimeCrevice  = 0.75;      // extra darkening in AO-occluded crevices (grounding)
const float kStainThresh   = 0.44;      // grunge value below which a stain forms
const float kStainEdge     = 0.07;      // smoothstep band (small = hard, defined edge)
const float kStainOpacity  = 0.82;      // how opaque a stain sits over the albedo
// Dirt is NOT one flat colour: a stain blends across earthy tones (brown -> ochre -> soot) by a
// SMOOTH hue selector (a coarse overlay sample, not a cell grid — cells made straight seams), plus
// per-texel brightness mottle, so colour varies within and between marks. Green goo pools on
// floors, but never on an already-green (goo/slime) surface.
const vec3  kDirtBrown     = vec3(0.22, 0.14, 0.08);  // core dirt
const vec3  kDirtOchre     = vec3(0.30, 0.20, 0.09);  // lighter earthy streaks
const vec3  kDirtDark      = vec3(0.11, 0.07, 0.04);  // deep dark-brown patches
const vec3  kSootColour    = vec3(0.06, 0.05, 0.045); // dark grime
const vec3  kGooColour     = vec3(0.12, 0.42, 0.06);  // green goo (floors only)
const float kGooChance     = 0.40;      // goo share of floor stains
// Marks come in a RANGE of sizes by summing the overlay at three world scales (big stains ->
// medium -> fine speckle); one scale alone reads as a repeating stamp. Weights sum to 1 so the
// combined value stays ~[0,1]. Per-octave UV offsets stop the scales aligning into a grid.
const vec3  kGrimeOctaveScale  = vec3(0.35, 1.0, 2.6); // x kGrimeWorldScale: large / medium / fine
const vec3  kGrimeOctaveWeight = vec3(0.50, 0.32, 0.18);

// DOOM-0042: the base HD sample UV for material id `id` at raw-texel coord `hitUV`. Dividing
// by the paletted texture's texel size maps hitUV into [0,1) tile space so an HD map tiles
// across the surface exactly like the paletted one; uvScale is the artist repeat multiplier.
// Every HD map (albedo/normal/AO/emissive/height) samples at this UV — or at the POM-marched
// offset of it (hdParallaxUV) — so they all line up.
vec2 hdBaseUV(uint id, vec2 hitUV, float uvScale)
{
    vec2 sz = vec2(textureSize(materialTex[nonuniformEXT(id)], 0));
    return (hitUV / sz) * uvScale;
}

// DOOM-0042 (Task 11): the hit triangle's tangent frame — T from dP/dU, B = n x T carrying
// the sign(det) mirror flip that X-flipped DOOM walls need. Split out of the normal-map
// unpack so Task 14's POM march can reuse the same frame for its view-space transform.
// Degenerate UVs (det ~ 0) fall back to an arbitrary stable frame.
void hdTangentFrame(vec3 n, vec3 p0, vec3 p1, vec3 p2, vec2 uv0, vec2 uv1, vec2 uv2,
                    out vec3 T, out vec3 B)
{
    vec3  e1 = p1 - p0, e2 = p2 - p0;
    vec2  d1 = uv1 - uv0, d2 = uv2 - uv0;
    float det = d1.x * d2.y - d1.y * d2.x;
    if (abs(det) < 1e-8) {                        // degenerate UVs -> arbitrary stable frame
        T = normalize(abs(n.z) < 0.999 ? cross(vec3(0,0,1), n) : cross(vec3(1,0,0), n));
        B = cross(n, T);
    } else {
        T = normalize((e1 * d2.y - e2 * d1.y) * (1.0 / det));
        T = normalize(T - n * dot(n, T));        // Gram-Schmidt against the geometric normal
        B = cross(n, T) * sign(det);             // handedness / mirror sign
    }
}

// DOOM-0042 (Task 14): parallax-occlusion-mapped sample UV. For a `pom`-flagged material with
// a height map, march the view ray (in the tangent frame) INTO the surface — white = raised,
// so the ray steps deeper until it dips below the height field, then one bisection refine.
// The step ramp + the nv floor bound the offset (worst case ~kPomHeightScale/0.05 of a tile at
// a grazing angle); it's NOT UV-clamped, so the REPEAT sampler wraps the small overshoot rather
// than smearing an edge texel, which avoids grazing-angle holes. `noPom` and non-pom / non-HD
// materials return baseUV unchanged (no march).
vec2 hdParallaxUV(MatCtrl mc, vec2 baseUV, vec3 T, vec3 B, vec3 n, vec3 dir)
{
    if (mc.usePBR == 0u || (mc.flags & 1u) == 0u || mc.maps[6] < 0) return baseUV;  // bit0 = pom
    vec3  vT = normalize(vec3(dot(-dir, T), dot(-dir, B), dot(-dir, n)));  // view dir, tangent space
    float nv = clamp(vT.z, 0.05, 1.0);
    int   steps = int(mix(32.0, 16.0, nv));      // 16 at normal incidence -> 32 grazing
    vec2  maxOff = (vT.xy / nv) * kPomHeightScale;
    float layer = 1.0 / float(steps);
    // Seed prev/cur from the TRUE height at the march origin (curD=0), so a first-step break
    // (a sharp peak) bisects against the real surface, not a placeholder gap of 1.0.
    float curH = textureLod(hdTex[nonuniformEXT(mc.maps[6])], baseUV, 0.0).r;   // white = raised
    float prevH = curH;
    vec2  curUV = baseUV, prevUV = baseUV;
    float curD = 0.0, prevD = 0.0;
    for (int i = 0; i < steps; i++) {
        prevUV = curUV; prevH = curH; prevD = curD;
        curD += layer;                           // marched depth 0..1
        curUV = baseUV - maxOff * curD;
        curH = textureLod(hdTex[nonuniformEXT(mc.maps[6])], curUV, 0.0).r;
        if (curD >= (1.0 - curH)) break;         // ray dipped below the height field
    }
    float h0 = (1.0 - prevH) - prevD;            // signed gap above the surface (prev step)
    float h1 = (1.0 - curH)  - curD;             // signed gap below the surface (cur step)
    float t  = h0 / max(h0 - h1, 1e-5);
    return mix(prevUV, curUV, clamp(t, 0.0, 1.0));
}

// DOOM-0042 (Task 10): linear albedo. An HD material (usePBR + an albedo map) samples its
// RGBA8 map at the shared `sUV` (base or POM-marched); the sRGB image VIEW does the
// gamma->linear decode in hardware, so no pow() here. Everything else (sprites, unmapped
// walls, the InitHdDefault fallback) routes to the paletted decodeAlbedo at raw `hitUV`.
vec3 hdAlbedo(MatCtrl mc, uint id, vec2 hitUV, vec2 sUV)
{
    if (mc.usePBR != 0u && mc.maps[0] >= 0)
        return texture(hdTex[nonuniformEXT(mc.maps[0])], sUV).rgb;   // sRGB view -> linear
    return decodeAlbedo(id, hitUV);
}

// DOOM-0042 (Task 11): world-space shading normal for an HD material — unpacks the tangent-
// space normal map (OpenGL Y+, no green flip) at the shared `sUV` and rotates it into world
// space with the precomputed frame (T,B from hdTangentFrame). Returns the geometric normal
// `n` unchanged when the material has no normal map (maps[1] < 0) or isn't HD, so a flat
// bring-up normal is an exact null result. Used as the LIGHTING normal; the caller keeps the
// geometric `n` for the SVGF G-buffer (denoiser edge-stopping) and lifts the shadow-ray origin.
vec3 hdShadingNormal(MatCtrl mc, uint id, vec2 sUV, vec3 n, vec3 T, vec3 B)
{
    if (mc.usePBR == 0u || mc.maps[1] < 0) return n;
    vec3 tn = texture(hdTex[nonuniformEXT(mc.maps[1])], sUV).xyz * 2.0 - 1.0;
    return normalize(tn.x * T + tn.y * B + tn.z * n);
}

// DOOM-0042 (Task 12): baked ambient-occlusion multiplier (single-channel .r, 1.0 = fully
// open, 0 = fully occluded) sampled at the shared `sUV`. 1.0 when the material has no AO map.
// The caller multiplies this into the AMBIENT / GI-bounce term ONLY, never the direct NEE or
// flashlight — so crevices darken under fill light without dimming a surface a torch shines on.
float hdAO(MatCtrl mc, uint id, vec2 sUV)
{
    if (mc.usePBR == 0u || mc.maps[4] < 0) return 1.0;
    return texture(hdTex[nonuniformEXT(mc.maps[4])], sUV).r;
}

// DOOM-0042 (Task 13): HD self-radiance (linear) from the emissive map at the shared `sUV`,
// black when the material has no emissive map. The sRGB image VIEW de-gammas in hardware. The
// caller adds `emis * kEmissiveScale` to the outgoing radiance on the DISPLAY (mode-4) path;
// the shipped denoised path (mode 6) keeps DOOM's existing per-material fullbright emission
// (svgf_composite re-adds it) — a dedicated per-texel HD emissive channel there is deferred
// (DOOM-0178), and v1 ships no emissive maps so nothing is lost meanwhile.
vec3 hdEmissive(MatCtrl mc, uint id, vec2 sUV)
{
    if (mc.usePBR == 0u || mc.maps[5] < 0) return vec3(0.0);
    return texture(hdTex[nonuniformEXT(mc.maps[5])], sUV).rgb;   // sRGB view -> linear
}

layout(push_constant) uniform PC {
    vec4  camPos;    // xyz = ray origin (world); w = sub-pixel jitter X (6-d)
    vec4  camDir;    // xyz = forward;            w = sub-pixel jitter Y (6-d)
    vec4  camRight;  // xyz = right,  w = tan(hFov/2)
    vec4  camUp;     // xyz = up,     w = tan(vFov/2)
    uvec4 misc;      // x = mode, y = width, z = height, w = numWall (flat-id offset)
    uvec4 misc2;     // x = emitter count (3b); y = probe count (4c);
                     // z = muzzle-flash strobe (muzzleFlashDelta); w = flashlight toggle (DOOM-0183 Q8)
    uvec4 misc3;     // step-4d verify: x = sample-seed base, y = spp this dispatch,
                     // z = estimator (0 = power-NEE, 1 = brute-force), w reserved
    uvec4 misc4;     // DOOM-0100: x = sprite material base (numWall+numFlat);
                     // y = omniStart (DOOM-0084); z = numSectors (DOOM-0119 REJECT
                     // cull dim, 0 = off); w = sky wall-texture id (DOOM-0141)
    uvec4 misc5;     // DOOM-0179: x = world-grime overlay bindless id in hdTex[]
                     // (0xFFFFFFFF = none); y = de-tile quality (DOOM-0181,
                     // 0/1/2 = off/2-tap/4-tap); z = dirt-colour texture id
                     // (DOOM-0181); w = filth master toggle (DOOM-0187, 1 = on)
    Verts    verts;    // level mesh vertex buffer (device address)
    Emitters emit;     // step-3b emitter list (device address; count in misc2.x)
    MatEmis  matEmis;  // per-material Le table (device address)
    ProbesRO probes;   // step-4 baked GI cache (device address; count in misc2.y)
    TriSs    triSs;     // per-triangle subsector id -> probe index (device address)
    Verts    spriteVerts; // DOOM-0100: per-frame billboard verts (device address; 0 if none)
    SubSec   subSec;   // DOOM-0119: subsector -> sector (device address; 0 if cull off)
    EmitSec  emitSec;  // DOOM-0119: per-emitter sector (device address; 0 if cull off)
    Reject   reject;   // DOOM-0119: REJECT bitmatrix words (device address; 0 if cull off)
    uvec4    misc6;    // DOOM-0183: x = ripple time (float bits, seconds); y = wet toggle
                       // (rb_wet: sheen/ripple/puddle only, not the glow).
                       // DOOM-0011: z = fog strength (rb_fog 0..3; 0 skips the march, INV-8).
                       // w = hell-haze density (reserved, wired at L4).
                       // std430-aligned to offset 224 (C++ pads the 216-byte tail; INV-6).
} pc;

// --- Camera-only shading constants (build step 3c/4b-iii) --------------------
const uint  NEE_SAMPLES = 6u;          // shadow rays/pixel. Emitters are picked by
                                       // POWER (3c-2, cdf binary search), so a few
                                       // samples land on the lights that matter. Raised
                                       // 4->6 in step 6c: the half-res lighting trace
                                       // casts these for only 1/4 of pixels, so 6 still
                                       // costs less than the old full-res 4 — spend the
                                       // freed budget on cleaner input (less source noise).
const float AMBIENT_FLOOR = 0.02;      // tiny fill for a triangle with no GI probe
                                       // (untagged) so it isn't pure black — the
                                       // step-4 probe bounce is the real fill now.
// DOOM-0043 (Ultra-only — only this megakernel runs it; Solid is the raster path):
// a gentle ambient floor that scales with the surface's DOOM sector lightlevel
// (per-vertex, 0..1). A sector the mapper marked bright reads as lit even with no
// emissive lamp texture; a dark sector stays dark so the flashlight (DOOM-0044)
// has somewhere to matter. INV-7 inline tunable — this is the playtest brightness
// knob (the feature is provisional pending playtest, per the DOOM-0043 roadmap).
const float AMBIENT_SECTOR_SCALE = 0.25;   // bright sector (light=1) -> 0.25 linear fill
// Exposure as a photographic EV (the Workbench exposureEv curve turns it into a
// linear gain: 1/(2^EV * 1.2)). -2.25 ≈ the old 4.0 gain, so this swap changes the
// tone *operator* without an exposure jump; the value gets its real tune in step 4c
// once the GI bake feeds the frame and the radiance levels settle.
const float EXPOSURE_EV   = -2.25;

// Muzzle-flash dynamic light (build step 5). A positional point light at the gun,
// active only while firing (the host passes player->extralight in misc2.z). Offset
// FORWARD + DROP from the eye so it sits at the barrel: as the player turns, the
// muzzle swings around the eye and its hard shadow tracks with it (a positionless
// screen-brighten could not). INV-7 backfill constants (inline, like the step-3
// scene-light values) pending a Workbench pass: warm flash colour, a radiant scale
// tuned for DOOM-unit 1/dist^2 falloff, and the barrel offset in world units.
const vec3  FLASH_COLOR     = vec3(1.0, 0.85, 0.6);
const float FLASH_INTENSITY = 3.0e6;   // the host gates this by extralight, which is only
                                       // 1or2 * 16/255 = 0.063/0.125 (A_Light1/2), so the
                                       // EFFECTIVE radiance is ~8-16x lower than the raw value.
                                       // At 3e6 a single flash (A_Light1) lands ~1.9e5 effective
                                       // -- ~3x the flashlight's 6e4 -- so a gunshot clearly
                                       // out-shines the headlamp and lights the whole room; the
                                       // big flash (A_Light2) is ~6x. A brief blinding burst when
                                       // firing point-blank is intended (it is a 1-2 frame flash).
const float FLASH_RADIUS2   = 1.5e4;   // (~122 u)^2 near-field softening (same idea as the
                                       // flashlight): caps the 1/dist^2 peak so firing with
                                       // the barrel against a wall doesn't blow out to white.
const float MUZZLE_FORWARD  = 24.0;
const float MUZZLE_DROP     = 8.0;

// Player flashlight / headlamp (DOOM-0044). A spotlight at the eye, aimed along
// the view direction (camPos/camDir already carry both), toggled by the player
// (the host forwards the on/off bit in misc2.w). Same hard ray-traced shadow +
// DOOM-unit 1/dist^2 falloff as the muzzle flash, plus a cone so it reads as a
// focused beam: full-bright inside ~23 deg, falling to zero by ~35 deg off-axis.
// Warm-white beam. INV-7 inline tunables (the cone + intensity get their real
// tune in a Workbench pass, like the muzzle-flash and scene-light constants).
const vec3  FLASHLIGHT_COLOR     = vec3(1.0, 0.97, 0.88);
const float FLASHLIGHT_INTENSITY = 6.0e4;
const float FLASHLIGHT_COS_IN    = 0.92;   // cos(~23 deg): full-bright cone core
const float FLASHLIGHT_COS_OUT   = 0.82;   // cos(~35 deg): beam edge fades to 0
const float FLASHLIGHT_RADIUS2   = 2.5e4;  // (~158 u)^2 near-field softening: the falloff
                                           // becomes 1/(dist^2 + R^2), so the 1/dist^2 term
                                           // can't blow up to a white blob when the player is
                                           // right against a wall. Caps the near-field peak
                                           // while leaving the mid/far gradient intact.

// Display tone map: lift by exposure, compress HDR->[0,1] with the hue-preserving
// Khronos PBR-Neutral operator (keeps DOOM's saturated palette where Reinhard/ACES
// would wash it out), then sRGB-encode per channel for the UNORM swapchain.
vec3 toneEncode(vec3 L)
{
    L = max(L, vec3(0.0)) * exposureEv(EXPOSURE_EV);
    L = pbrNeutralToneMapping(L);
    return vec3(linearToSrgb(L.r), linearToSrgb(L.g), linearToSrgb(L.b));
}

// DOOM-0100: a sprite billboard candidate is "opaque" (a real hit) only where its
// paletted texel is not index 0 (the transparent cut-out key). The sprite BLAS is
// the only NON-opaque geometry, so every triangle candidate the trace yields is a
// sprite: sample its texel at the candidate's barycentric UV and report whether the
// ray should commit here. Mirrors the raster sprite alpha-test (mesh.frag) and the
// world decode (same 18-float rb_vertex_t layout; UV at [6,7], material id at [8]).
bool spriteCandidateOpaque(rayQueryEXT rq)
{
    int  prim = rayQueryGetIntersectionPrimitiveIndexEXT(rq, false);
    vec2 bc   = rayQueryGetIntersectionBarycentricsEXT(rq, false);
    uint i0   = uint(prim) * 3u * 18u;
    int  texnum = floatBitsToInt(pc.spriteVerts.v[i0 + 8u]);
    vec2 uv = (1.0 - bc.x - bc.y) * vec2(pc.spriteVerts.v[i0 +  6u], pc.spriteVerts.v[i0 +  7u])
            +          bc.x        * vec2(pc.spriteVerts.v[i0 + 24u], pc.spriteVerts.v[i0 + 25u])
            +          bc.y        * vec2(pc.spriteVerts.v[i0 + 42u], pc.spriteVerts.v[i0 + 43u]);
    uint  id  = pc.misc4.x + uint(texnum);
    vec2  sz  = vec2(textureSize(materialTex[nonuniformEXT(id)], 0));
    float idx = texture(materialTex[nonuniformEXT(id)], uv / sz).r * 255.0;
    return idx >= 0.5;            // palette index 0 == transparent
}

// DOOM-0163: the world BLAS is now NON-opaque, so every primary-ray world hit is a
// triangle candidate. An ordinary wall/flat commits on the spot (one flag read); a
// two-sided masked mid-wall (grate/fence, FLAG_MASKED) commits only where its paletted
// texel is not index 0 -- the see-through cut-out key -- so rays pass through the gaps
// like the raster path (mesh.frag FLAG_MASKED discard). Masked mid-walls index their
// material by texnum direct (world walls, no atlas offset), matching the mode-3/4/6
// decode. Only the primary ray sees this; shadow/NEE/muzzle/flashlight/bake rays force
// gl_RayFlagsOpaqueEXT and treat the grate as solid.
bool worldCandidateOpaque(rayQueryEXT rq)
{
    int  prim  = rayQueryGetIntersectionPrimitiveIndexEXT(rq, false);
    uint i0    = uint(prim) * 3u * 18u;
    int  flags = floatBitsToInt(pc.verts.v[i0 + 9u]);
    if ((flags & FLAG_MASKED) == 0) return true;     // opaque wall/flat: commit
    int  texnum = floatBitsToInt(pc.verts.v[i0 + 8u]);
    vec2 bc = rayQueryGetIntersectionBarycentricsEXT(rq, false);
    vec2 uv = (1.0 - bc.x - bc.y) * vec2(pc.verts.v[i0 +  6u], pc.verts.v[i0 +  7u])
            +          bc.x        * vec2(pc.verts.v[i0 + 24u], pc.verts.v[i0 + 25u])
            +          bc.y        * vec2(pc.verts.v[i0 + 42u], pc.verts.v[i0 + 43u]);
    uint  id  = uint(texnum);
    vec2  sz  = vec2(textureSize(materialTex[nonuniformEXT(id)], 0));
    float idx = texture(materialTex[nonuniformEXT(id)], uv / sz).r * 255.0;
    return idx >= 0.5;            // palette index 0 == transparent
}

// DOOM-0130: dynamic point-light deltas shared by the display (mode 4) and the
// denoise-feed (mode 6) shading paths, which carried byte-identical muzzle-flash
// and flashlight blocks save for the albedo factor. Each returns one light's added
// radiance: a hard ray-traced shadow gate + 1/dist^2 falloff. albedo is applied
// here in the original left-to-right order, so the display path (real albedo) is
// bit-identical to the pre-refactor arithmetic and the demodulated feed passes
// vec3(1.0) — also bit-exact, since 1.0*x == x in IEEE.

// Muzzle flash: a point light at the gun barrel (eye + forward/drop offset) while
// firing. The offset swings the muzzle as the player turns, so the cast shadow
// tracks it. Gated by the host firing strobe in misc2.z (0.0 = not firing).
vec3 muzzleFlashDelta(vec3 hitP, vec3 n, vec3 albedo)
{
    float flash = uintBitsToFloat(pc.misc2.z);
    if (flash <= 0.0) return vec3(0.0);
    vec3  muzzle = pc.camPos.xyz + pc.camDir.xyz * MUZZLE_FORWARD
                 + vec3(0.0, 0.0, -MUZZLE_DROP);
    vec3  md     = muzzle - hitP;
    float mdist2 = dot(md, md);
    float mdist  = sqrt(mdist2);
    vec3  mwi    = md / mdist;
    float mcos   = dot(n, mwi);
    if (mcos <= 0.0 || mdist2 <= 1.0) return vec3(0.0);
    rayQueryEXT sq;
    rayQueryInitializeEXT(sq, topAS,
        gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT, 0x01u,
        hitP + n * 1e-3, 1e-3, mwi, mdist - 2e-3);
    while (rayQueryProceedEXT(sq)) {}
    if (rayQueryGetIntersectionTypeEXT(sq, true)
        != gl_RayQueryCommittedIntersectionNoneEXT) return vec3(0.0);
    return albedo * (1.0 / PI) * FLASH_COLOR
         * (flash * FLASH_INTENSITY) * mcos
         / (mdist2 + FLASH_RADIUS2);
}

// DOOM-0044 player flashlight (headlamp): an eye-mounted spotlight aimed along the
// view, gated by the rb_flashlight toggle (misc2.w). Same hard shadow + 1/dist^2 as
// the muzzle flash, plus a cone attenuation (how closely surface->eye hugs camDir).
vec3 flashlightDelta(vec3 hitP, vec3 n, vec3 albedo)
{
    if (pc.misc2.w == 0u) return vec3(0.0);
    vec3  fl    = pc.camPos.xyz - hitP;     // surface -> eye (the lamp)
    float fl2   = dot(fl, fl);
    float fdist = sqrt(fl2);
    vec3  fwi   = fl / fdist;
    float fcos  = dot(n, fwi);
    float spot  = smoothstep(FLASHLIGHT_COS_OUT, FLASHLIGHT_COS_IN,
                             dot(-fwi, pc.camDir.xyz));
    if (fcos <= 0.0 || spot <= 0.0 || fl2 <= 1.0) return vec3(0.0);
    rayQueryEXT sq;
    rayQueryInitializeEXT(sq, topAS,
        gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT, 0x01u,
        hitP + n * 1e-3, 1e-3, fwi, fdist - 2e-3);
    while (rayQueryProceedEXT(sq)) {}
    if (rayQueryGetIntersectionTypeEXT(sq, true)
        != gl_RayQueryCommittedIntersectionNoneEXT) return vec3(0.0);
    return albedo * (1.0 / PI) * FLASHLIGHT_COLOR
         * (FLASHLIGHT_INTENSITY * spot) * fcos
         / (fl2 + FLASHLIGHT_RADIUS2);
}

// -----------------------------------------------------------------------------
// DOOM-0183: glowing / wet nukage + glowing lava. Cheap, self-contained wet look —
// a direct-light sheen (NO reflection ray, NO GGX lobe: those are DOOM-0103) plus a
// procedural ripple normal. The glow + cast-light is CPU-built into the NEE emitter set
// (g.matEmissive, forced Le), so it is NOT here (INV-7). Every layer below is Ultra-RT-only
// by construction and gates on wetOn() (rb_wet); the glow it does not touch is permanent.
// -----------------------------------------------------------------------------
const uint LIQUID_NUKAGE = 8u;    // MatCtrl.flags bit3 (set by flat name on the CPU, §4.2)
const uint LIQUID_LAVA   = 16u;   // bit4 — glow + cast-light only; no sheen/ripple (INV-9)

const float kWetSheenPower    = 48.0;   // sheen tightness (large = smaller, sharper glint)
const float kWetSheenStrength = 0.6;    // sheen brightness (respect tonemap headroom, Q7)
const float kRippleScale = 1.0 / 48.0;  // 1/world-units: ripple field wavelength
const float kRippleSpeed = 2.2;         // radians/second scroll (frame-rate independent)
const float kRippleAmp   = 0.11;        // normal-tilt amplitude (shallow shimmer, not surf)
const float kPuddleGlow       = 0.35;   // additive goo-puddle glow (well below the source pool)
const float kPuddleSheenScale = 0.6;    // puddle sheen relative to the full nukage sheen

bool  isNukage(MatCtrl mc) { return (mc.flags & LIQUID_NUKAGE) != 0u; }
bool  wetOn()              { return pc.misc6.y == 1u; }
float rippleTime()         { return uintBitsToFloat(pc.misc6.x); }

// Perturb a floor normal with a shallow scrolling wave gradient (§4.5). Two layers at
// different world scales + directions; the analytic gradient of sin() tilts n in world XY
// (nukage flats are up-facing, so a world-XY tilt IS the tangent-plane tilt). World-XY keyed
// (wp = hitP.xy) so the pattern is continuous across a pool and does not swim with the camera.
vec3 rippleNormal(vec3 n, vec2 wp, float t) {
    const vec2 d1 = vec2( 0.80,  0.60);
    const vec2 d2 = vec2(-0.55,  0.83);
    float p1 = dot(wp, d1) * kRippleScale        + t * kRippleSpeed;
    float p2 = dot(wp, d2) * kRippleScale * 1.7  - t * kRippleSpeed * 0.8;
    vec2  grad = kRippleAmp * (d1 * cos(p1) + d2 * cos(p2));
    return normalize(n + vec3(grad, 0.0));
}

// A direct-light specular highlight of the ACTUAL lights (flashlight + muzzle) — not a mirror
// of the room (INV-3: no reflection ray). Half-vector Blinn-Phong. The flashlight is eye-mounted
// (L ~ V), a reliable forward gleam in dark goo rooms; the muzzle is offset, so its glint sweeps
// as the player fires/turns. Reuses the DOOM-0044/0130 light consts; `n` is the rippled normal.
vec3 wetSheen(vec3 hitP, vec3 n) {
    vec3 V = normalize(pc.camPos.xyz - hitP);    // surface -> eye
    vec3 sheen = vec3(0.0);
    if (pc.misc2.w != 0u) {                      // flashlight on
        vec3  H = normalize(V + V);              // L ~ V (co-located with the eye)
        float s = pow(max(dot(n, H), 0.0), kWetSheenPower);
        sheen += FLASHLIGHT_COLOR * (kWetSheenStrength * s);
    }
    float flash = uintBitsToFloat(pc.misc2.z);   // muzzle-flash strobe (0 = not firing)
    if (flash > 0.0) {
        vec3  muzzle = pc.camPos.xyz + pc.camDir.xyz * MUZZLE_FORWARD + vec3(0.0, 0.0, -MUZZLE_DROP);
        vec3  L = normalize(muzzle - hitP);
        vec3  H = normalize(V + L);
        float s = pow(max(dot(n, H), 0.0), kWetSheenPower);
        sheen += FLASH_COLOR * (kWetSheenStrength * flash * s);
    }
    return sheen;
}

// DOOM-0181: stochastic de-tiling (world-keyed offset + mirror + 4-corner blend). Breaks the
// within-surface repetition of an HD map by giving each world-space cell its own sub-tile UV
// offset and (maybe) a horizontal mirror, then blending neighbouring cells so no hard seam
// shows. World-keyed (INV-4): two same-texture walls at different world positions get different
// variation. Transform set is {offset, mirror} ONLY (INV-1) — DOOM walls are vertical, so no
// rotation / vertical-flip. Ultra RT view only, gated on detileOn() + usePBR.
const float kDetileWorldCell  = 64.0;   // world units per variation cell (§10 Q2 tunable; 96->64
                                        // 2026-07-16: smaller cell = shuffle changes more often
                                        // across a wall, breaks the repeat harder per user play-test)
const float kDetileOffsetMag  = 0.65;   // sub-tile offset magnitude, in tiles (± ; 0.5->0.65 = more
                                        // decorrelation between neighbouring cells)
const float kDetileMirrorProb = 0.5;    // P(a cell is horizontally mirrored)

// vec3 hash of an integer cell, built on the existing pcgHash PRNG (no new algorithm). The two
// odd multipliers decorrelate x and y before hashing; the +1u/+2u re-hashes give 3 independent
// [0,1) channels (xy = offset, z = mirror decision).
vec3 hash3(ivec2 cell) {
    uint s = pcgHash(uint(cell.x) * 0x9E3779B1u ^ uint(cell.y) * 0x85EBCA77u);
    return vec3(pcgHash(s), pcgHash(s + 1u), pcgHash(s + 2u)) * (1.0 / 4294967296.0);
}

// Dominant-axis world projection of the hit point (matches applyGrime): floors/ceilings->xy,
// ±x walls->yz, ±y walls->xz. Returns the 2-D world coordinate the cell grid is quantised on.
vec2 detileWorldUV(vec3 hitP, vec3 n) {
    vec3 an = abs(n);
    return (an.z >= an.x && an.z >= an.y) ? hitP.xy
         : (an.x >= an.y)                 ? hitP.yz
                                          : hitP.xz;
}

// misc5.y quality dial: 0 = off, 1 = 2-tap, 2 = 4-tap; any other value = off.
bool detileOn()   { return pc.misc5.y == 1u || pc.misc5.y == 2u; }
int  detileTaps() { return pc.misc5.y == 2u ? 4 : (pc.misc5.y == 1u ? 2 : 0); }

// misc5.w: filth (dirt-stain) master toggle — 1 = on (shipped look), 0 = off (`[` key).
// DOOM-0187: lets applyGrime be A/B'd live to isolate the stain-fetch cost; off is also a
// standing perf/quality option. Applies to ALL non-sprite world surfaces (not HD-gated).
bool filthOn() { return pc.misc5.w == 1u; }

// Per-cell transform of the sampling coordinate sUV: signed sub-tile offset + optional horizontal
// mirror (flip U within the cell; INV-1). Returns the transformed UV for cell `c`.
vec2 detileCellUV(vec2 sUV, ivec2 c) {
    vec3 h = hash3(c);
    vec2 off = (h.xy - 0.5) * 2.0 * kDetileOffsetMag;
    vec2 uv = sUV + off;
    if (h.z < kDetileMirrorProb) uv.x = -uv.x;   // horizontal mirror only
    return uv;
}

// De-tiled sample of HD map `mapIdx` at surface UV `sUV`, world-cell coord `g = w/kDetileWorldCell`.
// Inigo-Quilez 4-corner blend: sample the neighbouring cells' transformed UVs and blend by the
// smooth fractional position. 2-tap mode blends the two nearest cells along X only.
vec3 detile(uint mapIdx, vec2 sUV, vec2 g) {
    ivec2 cell = ivec2(floor(g));
    vec2  f    = fract(g);
    vec2  b    = smoothstep(vec2(0.25), vec2(0.75), f);
    vec3 s00 = texture(hdTex[nonuniformEXT(mapIdx)], detileCellUV(sUV, cell + ivec2(0,0))).rgb;
    vec3 s10 = texture(hdTex[nonuniformEXT(mapIdx)], detileCellUV(sUV, cell + ivec2(1,0))).rgb;
    if (detileTaps() < 4) {                       // 2-tap: blend the two nearest cells on X only
        return mix(s00, s10, b.x);
    }
    vec3 s01 = texture(hdTex[nonuniformEXT(mapIdx)], detileCellUV(sUV, cell + ivec2(0,1))).rgb;
    vec3 s11 = texture(hdTex[nonuniformEXT(mapIdx)], detileCellUV(sUV, cell + ivec2(1,1))).rgb;
    return mix(mix(s00, s10, b.x), mix(s01, s11, b.x), b.y);
}

// DOOM-0181 L2: scalar (.r) de-tile — for the AO map. Same 4-corner blend as detile().
float detileR(uint mapIdx, vec2 sUV, vec2 g) {
    ivec2 cell = ivec2(floor(g)); vec2 f = fract(g);
    vec2 b = smoothstep(vec2(0.25), vec2(0.75), f);
    float s00 = texture(hdTex[nonuniformEXT(mapIdx)], detileCellUV(sUV, cell + ivec2(0,0))).r;
    float s10 = texture(hdTex[nonuniformEXT(mapIdx)], detileCellUV(sUV, cell + ivec2(1,0))).r;
    if (detileTaps() < 4) return mix(s00, s10, b.x);
    float s01 = texture(hdTex[nonuniformEXT(mapIdx)], detileCellUV(sUV, cell + ivec2(0,1))).r;
    float s11 = texture(hdTex[nonuniformEXT(mapIdx)], detileCellUV(sUV, cell + ivec2(1,1))).r;
    return mix(mix(s00, s10, b.x), mix(s01, s11, b.x), b.y);
}

// DOOM-0181 L2: tangent-space normal de-tile. Unpack the normal PER cell and negate its X on a
// mirrored cell (INV-2 — a horizontal flip reverses tangent handedness, so relief points the
// right way), then blend. Returns the blended tangent-space normal (caller rotates by T,B,n).
vec3 detileNormalTS(uint mapIdx, vec2 sUV, vec2 g) {
    ivec2 cell = ivec2(floor(g)); vec2 f = fract(g);
    vec2 b = smoothstep(vec2(0.25), vec2(0.75), f);
    int taps = detileTaps();
    vec3 acc = vec3(0.0); float wsum = 0.0;
    for (int i = 0; i < (taps < 4 ? 2 : 4); i++) {
        ivec2 corner = (taps < 4) ? ivec2(i, 0) : ivec2(i & 1, i >> 1);
        ivec2 c = cell + corner;
        vec3  tn = texture(hdTex[nonuniformEXT(mapIdx)], detileCellUV(sUV, c)).xyz * 2.0 - 1.0;
        if (hash3(c).z < kDetileMirrorProb) tn.x = -tn.x;   // mirror flips tangent handedness
        float wx = (corner.x == 0) ? (1.0 - b.x) : b.x;
        float wy = (taps < 4) ? 1.0 : ((corner.y == 0) ? (1.0 - b.y) : b.y);
        acc += tn * (wx * wy); wsum += wx * wy;
    }
    return acc / max(wsum, 1e-4);
}

// DOOM-0181 L3: parallax-occlusion march in de-tiled space (§4.4). Compute the dominant cell's
// offset+mirror ONCE, march the height field in that single cell's frame (NOT per-step blended —
// that would cost taps × march-steps), then hand back a coordinate the §4.2 4-corner albedo/
// normal/AO wrappers can still de-tile in ONE step. Key subtlety: the wrappers re-apply the
// per-cell offset+mirror themselves, so we must NOT return the already-offset marched coordinate
// (that double-transforms). Instead transfer only the parallax DISPLACEMENT (marched - duv) onto
// the clean baseUV: then detileCellUV(result, dominantCell) lands exactly on the marched texel, so
// relief registers with colour, while neighbour cells in the blend cross-fade and hide the seam.
// INV-2: the march dir's tangent-X is negated on a mirrored cell (so relief doesn't invert), and
// the transferred displacement's U is negated too so it survives the wrapper's re-mirror.
vec2 detilePOM(MatCtrl mc, vec2 baseUV, vec3 T, vec3 B, vec3 n, vec3 dir, vec2 g) {
    if (mc.maps[6] < 0) return baseUV;                 // no height map -> hdParallaxUV is a no-op anyway
    ivec2 cell = ivec2(floor(g));
    vec2  f    = fract(g);
    // Border band (start 0.1): near a cell edge two adjacent pixels can pick different dominant
    // cells and the single-cell march would seam. Skip the march there and let the wrappers de-tile
    // the plain baseUV (§4.4 fallback; the 0.1 band width is the §10 Q1 tuning knob).
    if (min(min(f.x, 1.0 - f.x), min(f.y, 1.0 - f.y)) < 0.1) return baseUV;
    bool mir  = hash3(cell).z < kDetileMirrorProb;
    vec2 duv  = detileCellUV(baseUV, cell);            // this cell's offset+mirror, applied once
    vec3 mdir = dir;
    if (mir) mdir -= 2.0 * dot(mdir, T) * T;           // mirror the march dir's tangent-X (INV-2)
    vec2 d = hdParallaxUV(mc, duv, T, B, n, mdir) - duv;   // parallax displacement in the cell frame
    return baseUV + vec2(mir ? -d.x : d.x, d.y);       // transfer to clean UV (cancels wrapper re-mirror)
}

// DOOM-0179: world-space grime overlay. The base HD texture tiles with the surface (every
// 64-128 units); this multiplies in a single low-frequency grunge map sampled by WORLD
// position instead, so identical tiles on different walls pick up different grime and stop
// reading as copies. Dominant-axis projection (DOOM geometry is axis-aligned, z up: floors/
// ceilings face ±z, walls face ±x or ±y — so a hard axis pick is exact, no triplanar blend).
// The blend is CENTRED on the map's 0.5 mean (m = 1 + (g-0.5)*2*strength): net-neutral
// exposure, dark specks darken and clean spots lighten. Applied to HD (usePBR) surfaces only
// — paletted/Classic art is left byte-identical. `gid` is the overlay's hdTex[] slot from the
// host (pc.misc5.x); 0xFFFFFFFF (the default all-paletted set, or grime disabled) is a no-op.
// Multi-scale ("randomly-sized") grunge: the overlay summed at three world scales + offsets so
// marks range from big stains to fine speckle instead of one repeating size.
float grungeFbm(uint gid, vec2 wUV)
{
    float s = kGrimeWorldScale;
    return kGrimeOctaveWeight.x * texture(hdTex[nonuniformEXT(gid)], wUV * (s*kGrimeOctaveScale.x) + vec2(0.13, 0.71)).r
         + kGrimeOctaveWeight.y * texture(hdTex[nonuniformEXT(gid)], wUV * (s*kGrimeOctaveScale.y) + vec2(0.51, 0.19)).r
         + kGrimeOctaveWeight.z * texture(hdTex[nonuniformEXT(gid)], wUV * (s*kGrimeOctaveScale.z) + vec2(0.87, 0.43)).r;
}

// Smooth, mottled, MULTI-HUE dirt colour — no cell grid, so no straight seams. `hue` (a coarse
// smooth overlay sample) picks the earthy tone; `bright` (the per-texel grunge) mottles it. Green
// goo pools on up-facing floors, but never on an already-green (goo/slime) surface.
// Dirt-stain colour. When a real dirt COLOUR texture is loaded (pc.misc5.z, DOOM-0181) it drives
// the colour — sampled at a macro world scale for organic tonal/hue variation, times a finer
// sample for close-up grain — so filth reads as a photographed dirt texture, not a flat tint.
// Falls back to a procedural earthy ramp (three grunge scales) when no dirt texture is present.
// Green goo pools on up-facing floors (coarse grunge selector) but never on already-green surfaces.
vec3 stainColour(uint gid, vec2 wUV, vec3 n, vec3 albedo)
{
    bool green = albedo.g > albedo.r * 1.15 && albedo.g > albedo.b * 1.15;   // already goo/slime
    if (n.z > 0.6 && !green) {
        float goo = texture(hdTex[nonuniformEXT(gid)], wUV * (kGrimeWorldScale * 0.12) + vec2(3.1, 1.7)).r;
        if (goo < kGooChance)
            return kGooColour * (0.70 + 0.6 * texture(hdTex[nonuniformEXT(gid)], wUV * (kGrimeWorldScale * 3.3)).r);
    }
    uint did = pc.misc5.z;
    if (did != 0xFFFFFFFFu) {                                                 // real dirt texture
        vec3 macro = texture(hdTex[nonuniformEXT(did)], wUV * (kGrimeWorldScale * 0.5)).rgb;
        float fine = texture(hdTex[nonuniformEXT(did)], wUV * (kGrimeWorldScale * 2.0) + vec2(0.37)).r;
        return macro * (0.72 + 0.55 * fine);                                 // macro colour x fine grain
    }
    float s     = kGrimeWorldScale;                                          // procedural fallback
    float tone  = texture(hdTex[nonuniformEXT(gid)], wUV * (s * 0.12) + vec2(3.1, 1.7)).r;
    float blot  = texture(hdTex[nonuniformEXT(gid)], wUV * (s * 0.90) + vec2(0.6, 4.2)).r;
    float grain = texture(hdTex[nonuniformEXT(gid)], wUV * (s * 3.30) + vec2(2.8, 0.4)).r;
    vec3  dirt  = mix(kDirtDark, kDirtBrown, smoothstep(0.20, 0.55, tone));
    dirt        = mix(dirt, kDirtOchre, smoothstep(0.55, 0.85, tone));
    dirt       *= mix(0.60, 1.15, blot);
    dirt       *= (0.85 + 0.30 * grain);
    return mix(dirt, kSootColour, smoothstep(0.82, 0.97, blot) * 0.5);
}

vec3 applyGrime(vec3 albedo, vec3 hitP, vec3 n, float ao, out float gooWet)
{
    gooWet = 0.0;                                        // DOOM-0183 L5: green-goo puddle coverage
    // Liquids (nukage/slime — a saturated-green albedo) are not a paintable surface: no dirt, no
    // goo, no crevice grime lands on flowing liquid. Leave them untouched (user 2026-07-16).
    if (albedo.g > albedo.r * 1.15 && albedo.g > albedo.b * 1.15) return albedo;
    vec2 wUV = detileWorldUV(hitP, n);                    // dominant-axis world projection (shared)
    uint gid = pc.misc5.x;
    float m = 1.0;
    float stain = 0.0, g = 0.5;
    if (gid != 0xFFFFFFFFu) {                             // DOOM-0179 grunge overlay present
        g = grungeFbm(gid, wUV);                         // UNORM 0..1, mixed-size marks
        m = 1.0 + (g - 0.5) * 2.0 * kGrimeStrength;       // subtle large-scale grounding
        stain = smoothstep(kStainThresh, kStainThresh - kStainEdge, g);  // distinct hard-edged mark
    }
    m -= (1.0 - ao) * kGrimeCrevice;                     // dirt darkens genuine crevices (INV-7)
    vec3 c = albedo * clamp(m, 0.35, 1.65);              // INV-6 clamp preserved
    if (stain > 0.0 && gid != 0xFFFFFFFFu) {             // distinct mottled dirt on top
        c = mix(c, stainColour(gid, wUV, n, albedo), stain * kStainOpacity);
        // DOOM-0183 L5: report the GREEN-GOO puddle coverage using the SAME floor + goo-selector
        // test stainColour uses, so the mode block can wet those puddles (§4.6). Up-facing floor
        // goo only — brown dirt on a wall is not wet. (albedo is already non-green: early return.)
        if (n.z > 0.6) {
            float goo = texture(hdTex[nonuniformEXT(gid)], wUV * (kGrimeWorldScale * 0.12) + vec2(3.1, 1.7)).r;
            if (goo < kGooChance) gooWet = stain;
        }
    }
    return c;
}

// DOOM-0141: sample the classic DOOM sky panorama for a primary ray. Mirrors the
// raster path (mesh.frag FLAG_SKY): a cylindrical projection keyed on the view yaw
// (from camDir) and screen position — 90 deg of view spans one sky-texture width,
// the 128px sky pins its row 100 to the horizon at screen centre, both axes REPEAT-
// wrap. Returns DISPLAY-encoded (palette) colour, fullbright: the sky is a backdrop,
// not a lit surface, so the mode-4 path and the composite output it WITHOUT tonemap,
// matching the Solid/raster sky exactly. pc.misc4.w is the sky wall-texture bindless
// id (0xFFFFFFFF when the level has no sky -> fall back to the flat SKY_COLOR fill).
vec3 skyPanorama(uvec2 px, uint w, uint h)
{
    if (pc.misc4.w == 0xFFFFFFFFu) return SKY_COLOR;
    uint  id   = pc.misc4.w;
    vec2  sz   = vec2(textureSize(materialTex[nonuniformEXT(id)], 0));
    float yaw  = atan(pc.camDir.y, pc.camDir.x);       // view yaw (x east, y north)
    vec2  suv  = (vec2(px) + 0.5) / vec2(float(w), float(h));   // [0,1] across the frame
    float ndcX = suv.x * 2.0 - 1.0;
    float ang  = yaw - atan(ndcX);                     // matches mesh.frag's screen term
    float col  = ang / (PI * 0.5) * sz.x;              // 90 deg view = one texture width
    float row  = 100.0 + (suv.y - 0.5) * 200.0;        // classic fixed sky scale
    // DOOM-0143: below the horizon the fixed scale runs `row` past the 128px sky
    // texture; the sampler's vertical REPEAT then wraps it to the bright top-of-
    // sky rows -- a bright band wherever the RT sky backdrop fills BELOW eye
    // level (a window / vista). Classic DOOM never draws sky there, so the pixel
    // is undefined: wrapping gives a bright strip, clamping to the base gives a
    // dark one (the DOOM-0076 black band). Clamp to kill the bright wrap, then
    // FADE the below-horizon strip into a soft haze so the mountains dissolve
    // into mist at the wall line instead of showing either hard seam. The fog
    // rises with screen depth past the horizon, so it is densest exactly where
    // the sky meets the wall, wherever that sits -- no wall-height term needed.
    // RT-only (skyPanorama); the raster twin (mesh.frag) is untouched, so the
    // DOOM-0076 fix there cannot regress. Tunable: fog tone + onset/full band.
    row = min(row, sz.y - 0.5);                        // no vertical wrap
    float idx  = texture(materialTex[nonuniformEXT(id)], vec2(col, row) / sz).r * 255.0;
    vec3  skyCol = texture(paletteTex, vec2((idx + 0.5) / 256.0, 0.5)).rgb;
    const vec3 SKY_FOG_COL = vec3(0.5);                // neutral haze tone
    float fog  = smoothstep(0.50, 0.63, suv.y);        // 0 at/above horizon -> 1 at the wall
    // DOOM-0011 L1b §4.6a/Q14: real aerial-perspective fog is now folded onto this
    // whole sky backdrop (pathtrace.comp mode-4/6 sky branches, closed-form), so at
    // full strength this band would double-haze the horizon. Halve it -- it still
    // masks the DOOM-0143 below-horizon vertical-wrap seam, just less aggressively.
    // Byte-identical to before when fog is off (INV-8); final balance is a Step-7 eye-check.
    if (pc.misc6[2] != 0u) fog *= 0.5;
    return mix(skyCol, SKY_FOG_COL, fog);
}

// DOOM-0011: view-ray fog march, single scattering, mode 4 (full-res) + mode 6
// (half-res). hitP/gnormal/matFlags are the primary-hit fields later layers (L2-L4)
// read for height pooling / area profiles; L1's sky-ambient term is position- and
// hit-independent, so it reads none of them yet — the struct + signature are fixed
// now so L2-L4 fill fields without re-plumbing the call sites (§4.1).
struct FogHit { vec3 hitP; vec3 gnormal; uint matFlags; }; // L2-L4 read these

// Returns (inscatter.rgb, transmittance). Linear radiance. rb_fog>0 checked by the caller.
vec4 marchFog(vec3 ro, vec3 rd, float tHit, FogHit h)
{
    float tMax = min(tHit, kFogMaxDist);
    float dt   = tMax / float(kFogSteps);
    // Dither the start offset so a fixed step count doesn't band (denoise cleans it, §4.6).
    float jitter = fract(52.9829189 * fract(dot(gl_GlobalInvocationID.xy, vec2(0.06711056, 0.00583715))));
    float t = dt * jitter;

    vec3  inscatter = vec3(0.0);
    float trans     = 1.0;
    vec3  skyAmbient = SKY_COLOR * kSkyShaftStrength;   // L1: flat, non-directional
    float strength   = fogStrengthScale(pc.misc6.z);   // the `;` dial: Low/Med/High thins the air

    for (int i = 0; i < kFogSteps; ++i, t += dt) {
        vec3  p     = ro + rd * t;
        // §4.3a open-sky exposure standard: a straight-up shadow ray that MISSES all
        // solid geometry means this sample sits under open sky (full haze); a HIT means
        // indoors (near-clear). Mirrors occluded()'s cull-mask-0x01 ray-query exactly
        // (pt_common.glsl) rather than inventing a new one; the sky backdrop itself is
        // instance mask 0x04 (r_vulkan.cpp) which a 0x01 ray cannot hit, so it can never
        // falsely register as "indoor". occluded() takes a surface normal to bias the ray
        // origin off the surface -- p is a mid-air march sample, not a surface hit, so the
        // up direction doubles as that bias (n == wi == up); harmless 1e-3-unit nudge.
        bool  openSky = !occluded(p, vec3(0.0, 0.0, 1.0), vec3(0.0, 0.0, 1.0), kFogMaxDist);
        float skyExposure = openSky ? 1.0 : kIndoorFogScale;
        float sigma = fogDensity(p) * strength * skyExposure;
        vec3  Ls    = skyAmbient;                        // L2 adds directional sky + torches
        inscatter += trans * sigma * Ls * dt;
        trans     *= exp(-sigma * dt);
        if (trans < 0.003) break;                        // thick fog occludes the rest cheaply
    }
    return vec4(inscatter, trans);
}

void main()
{
    const uvec2 px = gl_GlobalInvocationID.xy;
    const uint  w  = pc.misc.y;
    const uint  h  = pc.misc.z;
    if (px.x >= w || px.y >= h)
        return;

    // Primary ray: pixel centre -> NDC [-1,1], screen-y down so world up = -ndcY.
    // build step 6-d: an optional sub-pixel jitter (camPos.w / camDir.w, in render
    // pixels) shifts the sample point each frame so the temporal upscaler (TAAU/FSR)
    // reconstructs sub-pixel detail. Zero on the non-upscaled path, so the ray is
    // the exact pixel centre as before.
    const float ndcX = (2.0 * (float(px.x) + 0.5 + pc.camPos.w) / float(w)) - 1.0;
    const float ndcY = (2.0 * (float(px.y) + 0.5 + pc.camDir.w) / float(h)) - 1.0;
    const vec3  origin = pc.camPos.xyz;
    const vec3  dir = normalize(pc.camDir.xyz
                              + pc.camRight.xyz * (ndcX * pc.camRight.w)
                              + pc.camUp.xyz    * (-ndcY * pc.camUp.w));

    // DOOM-0129: the view-mode is a specialization constant, not a push-constant.
    // The host compiles one pipeline variant per shipped mode (RtPipelineForMode),
    // so every `if (mode == Nu)` for the other modes folds to `if (false)` and is
    // dead-stripped by the driver — fewer live registers, higher RDNA2 occupancy,
    // pixel-identical output (the executed path is unchanged). Default 6 = the
    // denoised Ultra play path. (pc.misc.x is now unused; misc.y/z/w still live.)
    layout(constant_id = 0) const uint mode = 6u;

    rayQueryEXT rq;
    // DOOM-0100/0163: drop gl_RayFlagsOpaqueEXT. Both the world BLAS (instance 0,
    // custom index 0) and the sprite BLAS (custom index 1) are non-opaque and yield
    // triangle candidates; the sky backdrop (custom index 2) stays opaque and auto-
    // commits. Sprite candidates alpha-test against the billboard cut-out; world
    // candidates commit unless they are a masked mid-wall's index-0 gap (DOOM-0163).
    rayQueryInitializeEXT(rq, topAS, gl_RayFlagsNoneEXT, 0xFFu,
                          origin, 0.01, dir, 1.0e9);
    while (rayQueryProceedEXT(rq)) {
        if (rayQueryGetIntersectionTypeEXT(rq, false)
            == gl_RayQueryCandidateIntersectionTriangleEXT)
        {
            bool keep = (rayQueryGetIntersectionInstanceCustomIndexEXT(rq, false) == 1)
                      ? spriteCandidateOpaque(rq)      // billboard sprite
                      : worldCandidateOpaque(rq);      // world wall/flat, masked mid-wall alpha-tested
            if (keep)
                rayQueryConfirmIntersectionEXT(rq);
        }
    }

    // DOOM-0141: a committed hit on the sky backdrop instance (custom index 2) is
    // rendered as the sky, NOT shaded as a surface — and because it was the committed
    // (nearest) hit, it OCCLUDES geometry behind it, exactly like classic DOOM's sky.
    // It funnels into the same per-mode sky output as a true miss below.
    const bool committed = rayQueryGetIntersectionTypeEXT(rq, true)
                           == gl_RayQueryCommittedIntersectionTriangleEXT;
    const bool isSky = committed
                       && rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true) == 2;

    vec3 colour;
    if (committed && !isSky)
    {
        // DOOM-0100: a hit is either the static world (instance 0) or a billboard
        // sprite (instance 1). Both share the rb_vertex_t layout (18 floats/vertex),
        // so select the matching vertex buffer and decode identically below.
        const bool isSprite = rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true) == 1;
        Verts vb = isSprite ? pc.spriteVerts : pc.verts;

        // Baked normal from the hit triangle's first vertex (flat-shaded world faces
        // share one normal across the face; sprite billboards bake a camera-facing
        // normal). Non-indexed soup, so vertex 0 of triangle p is at p*3.
        const int  prim = rayQueryGetIntersectionPrimitiveIndexEXT(rq, true);
        const uint i0   = uint(prim) * 3u * 18u;   // 18 floats/vertex
        vec3 n = vec3(vb.v[i0 + 3u], vb.v[i0 + 4u], vb.v[i0 + 5u]);
        n = normalize(n);
        if (dot(n, dir) > 0.0) n = -n;             // face the viewer

        // Barycentric-interpolate the hit's texture coords across the triangle. DOOM
        // faces are flat-SHADED (one normal per face, shared above), but a textured
        // surface's UVs VARY per vertex — sampling only vertex 0's UV for the whole
        // triangle (as the normal is shared) paints each face a single flat colour
        // (no texture). The rasteriser interpolates UVs for free; the tracer must do
        // it explicitly from the hit barycentrics. 18 floats/vertex, UV at [6,7].
        vec2 bc = rayQueryGetIntersectionBarycentricsEXT(rq, true);
        vec2 uv0 = vec2(vb.v[i0 +  6u], vb.v[i0 +  7u]);
        vec2 uv1 = vec2(vb.v[i0 + 24u], vb.v[i0 + 25u]);
        vec2 uv2 = vec2(vb.v[i0 + 42u], vb.v[i0 + 43u]);
        vec2 hitUV = (1.0 - bc.x - bc.y) * uv0 + bc.x * uv1 + bc.y * uv2;

        // DOOM-0042 (Task 11): the hit triangle's three world-space vertex positions, for
        // the normal-map tangent frame (dP/dU, dP/dV) built in hdShadingNormal. Positions
        // are floats [0,1,2] of each 18-float vertex. Unused in the mode variants that never
        // shade an HD normal (2/3/5) — `mode` is a spec constant, so each pipeline is
        // specialised at creation and the driver dead-strips the branches it can't reach.
        vec3 p0 = vec3(vb.v[i0 +  0u], vb.v[i0 +  1u], vb.v[i0 +  2u]);
        vec3 p1 = vec3(vb.v[i0 + 18u], vb.v[i0 + 19u], vb.v[i0 + 20u]);
        vec3 p2 = vec3(vb.v[i0 + 36u], vb.v[i0 + 37u], vb.v[i0 + 38u]);

        if (mode == 2u)
        {
            // White furnace: one cosine-weighted bounce, constant env L = 1,
            // albedo = 1, no occlusion. weight = brdf*cos/pdf = albedo, exactly.
            uint  seed = px.x + px.y * w;
            float u1 = rnd(seed), u2 = rnd(seed);
            vec3  t  = normalize(cross(abs(n.z) < 0.999 ? vec3(0,0,1) : vec3(1,0,0), n));
            vec3  b  = cross(n, t);
            float r  = sqrt(u1), phi = 2.0 * PI * u2;
            vec3  sd = t * (r * cos(phi)) + b * (r * sin(phi)) + n * sqrt(max(0.0, 1.0 - u1));
            float cosT = max(dot(n, sd), 0.0);
            float pdf  = cosT / PI;
            float brdf = 1.0 / PI;                  // albedo 1 Lambert
            float L    = 1.0;
            colour = vec3(pdf > 0.0 ? (brdf * cosT / pdf) * L : 0.0);
        }
        else if (mode == 3u)
        {
            // Textured (3a): decode the hit surface's DOOM material exactly as the
            // raster path (mesh.frag) does, then modulate by sector lightlevel.
            // Per-vertex data of the hit triangle's vertex 0 (flat-shaded faces
            // share it across all three vertices, like the normal above).
            int   texnum = floatBitsToInt(vb.v[i0 + 8u]);
            int   flags  = floatBitsToInt(vb.v[i0 + 9u]);
            float light  = vb.v[i0 + 10u];

            // Unified bindless id: sprites sit after the flats (offset misc4.x =
            // numWall+numFlat); flats sit after the walls (offset numWall); walls
            // (including two-sided masked mid-walls) index by texnum direct.
            int  id    = isSprite ? (int(pc.misc4.x) + texnum)
                       : (((flags & FLAG_FLAT) != 0) ? (int(pc.misc.w) + texnum) : texnum);
            vec2 sz    = vec2(textureSize(materialTex[nonuniformEXT(id)], 0));
            float idx  = texture(materialTex[nonuniformEXT(id)], hitUV / sz).r * 255.0;
            vec3 albedo = texture(paletteTex, vec2((idx + 0.5) / 256.0, 0.5)).rgb;

            colour = albedo * light;                // sector-light seed; NEE in 3c
        }
        else if (mode == 4u)
        {
            // NEE direct lighting (build step 3c). Decode the surface albedo into
            // linear space, then shade it (self-emission + power-importance NEE
            // direct, hard shadows) via the shared shadeSurface() — the SAME math
            // the GI bake runs at each probe-ray hit. A flat sky/sector ambient
            // stands in for the step-4 GI bake so lamp-less rooms aren't pure black.
            int   texnum = floatBitsToInt(vb.v[i0 + 8u]);
            int   flags  = floatBitsToInt(vb.v[i0 + 9u]);
            uint  id     = isSprite ? (pc.misc4.x + uint(texnum))
                         : (((flags & FLAG_FLAT) != 0) ? (pc.misc.w + uint(texnum))
                                                       : uint(texnum));
            // DOOM-0042 shared HD prologue (Tasks 11/14): the base UV, tangent frame, and POM
            // march are computed ONCE per hit, then every map (albedo/normal/AO/emissive)
            // samples at the resulting `sUV` so relief self-occludes consistently. The whole
            // block is gated on usePBR, so a paletted hit does NO extra work (sUV unused —
            // hdAlbedo samples raw hitUV) and is byte-identical to the pre-HD path.
            MatCtrl mc  = ctrl[id];                // one SSBO, runtime array -> no nonuniformEXT
            vec2    sUV = hitUV;                    // paletted default (unused by the paletted branch)
            vec3    T = n, B = n;
            float   tHit = rayQueryGetIntersectionTEXT(rq, true);   // HOISTED (DOOM-0181: hitP feeds the detile world-key)
            vec3    hitP = origin + dir * tHit;                     // HOISTED
            if (mc.usePBR != 0u) {
                vec2 baseUV = hdBaseUV(id, hitUV, mc.uvScale);
                hdTangentFrame(n, p0, p1, p2, uv0, uv1, uv2, T, B);
                // DOOM-0181 L3: march POM in the de-tiled coordinate so relief registers with the
                // de-tiled albedo/normal/AO (§4.4); else the plain-space POM march.
                sUV = detileOn()
                    ? detilePOM(mc, baseUV, T, B, n, dir, detileWorldUV(hitP, n) / kDetileWorldCell)
                    : hdParallaxUV(mc, baseUV, T, B, n, dir);
            }
            // DOOM-0181 L1: de-tile the albedo when the dial is on and this is an HD albedo map;
            // else the unchanged hdAlbedo path (paletted / no-albedo hits stay byte-identical).
            vec3 albedo;
            if (mc.usePBR != 0u && mc.maps[0] >= 0 && detileOn()) {
                vec2 g = detileWorldUV(hitP, n) / kDetileWorldCell;
                albedo = detile(uint(mc.maps[0]), sUV, g);
            } else {
                albedo = hdAlbedo(mc, id, hitUV, sUV);   // HD if usePBR, else paletted
            }
            // DOOM-0181 L4: fetch AO ONCE here (de-tiled to match albedo/normal; §4.3) — it feeds
            // both the crevice-pooled filth in applyGrime and the ambient term below. Paletted /
            // no-AO hits fall back to hdAO (== 1.0 there, so no crevice darkening).
            float ao = (mc.usePBR != 0u && mc.maps[4] >= 0 && detileOn())
                     ? detileR(uint(mc.maps[4]), sUV, detileWorldUV(hitP, n) / kDetileWorldCell)
                     : hdAO(mc, id, sUV);
            float gooWet = 0.0;   // DOOM-0183 L5: goo-puddle wet coverage (0 unless a green-goo puddle)
            if (!isSprite && filthOn()) albedo = applyGrime(albedo, hitP, n, ao, gooWet);   // DOOM-0179/0181 filth (all world surfaces; misc5.w toggle)

            // DOOM-0084: world surfaces self-emit as before; a sprite self-emits only
            // if it's a fullbright light Thing (lamp/torch/barrel), so ammo pickups and
            // monsters don't glow. The per-texel value mask in shadeSurface then keeps
            // the glow on the bright pixels (lamp top, not the dark stand).
            bool addEmis = isSprite ? ((flags & FLAG_EMISSIVE) != 0) : true;
            uint seed = px.x + px.y * w + 1u;
            // DOOM-0119: this hit's owning sector for the REJECT light cull. World hit
            // -> subsector (triSs) -> sector (subSec); sprite hits + the no-REJECT case
            // pass 0xFFFFFFFF (unknown) so shadeSurface leaves every light in play.
            // probeCount (misc2.y) == subsector count, so it bounds the triSs lookup.
            uint hitSec = 0xFFFFFFFFu;
            if (pc.misc4.z > 0u && !isSprite)
            {
                uint ss = pc.triSs.s[uint(prim)];
                if (ss < pc.misc2.y) hitSec = pc.subSec.s[ss];
            }
            // DOOM-0181 L2: de-tile the normal in lockstep with the albedo (same world cell), so a
            // mirrored/offset tile's relief matches its colour. INV-2: detileNormalTS negates the
            // per-cell tangent-X on a mirror. Paletted / no-normal-map hits keep hdShadingNormal.
            vec3 shadeN;
            if (mc.usePBR != 0u && mc.maps[1] >= 0 && detileOn()) {
                vec2 gN = detileWorldUV(hitP, n) / kDetileWorldCell;
                vec3 tn = detileNormalTS(uint(mc.maps[1]), sUV, gN);
                shadeN  = normalize(tn.x * T + tn.y * B + tn.z * n);
            } else {
                shadeN = hdShadingNormal(mc, id, sUV, n, T, B);
            }
            // shadeSurface/*Delta offset their shadow-ray origin along the normal they're
            // handed; a tilted bump normal shrinks the clearance off the true triangle
            // plane, so for a normal-mapped surface lift the shading point along the
            // GEOMETRIC normal first (paletted is byte-identical: guard is false there).
            vec3 shadeP = (mc.usePBR != 0u && mc.maps[1] >= 0) ? hitP + n * 2e-3 : hitP;
            // DOOM-0183 L4: nukage ripples the LIGHTING normal so the diffuse shade AND the
            // sheen shimmer coherently (INV-4: nukage only — lava + non-liquid keep n unperturbed).
            bool nukage = isNukage(mc);
            if (nukage && wetOn()) shadeN = rippleNormal(shadeN, hitP.xy, rippleTime());
            vec3 L = shadeSurface(shadeP, shadeN, albedo, id, pc.misc2.x, pc.misc4.y,
                                  pc.emit, pc.matEmis, NEE_SAMPLES, addEmis,
                                  hitSec, pc.misc4.z, pc.emitSec, pc.reject, seed);

            // Indirect GI (build step 4c) + DOOM-0043 sector-light ambient floor.
            // The probe holds the bounced solution; the floor is a deliberate,
            // designer-driven ambient seeded by the sector lightlevel (§4.2). max()
            // keeps GI wherever it already exceeds the floor, so lit rooms are
            // untouched (no double-count) and only dim/unprobed surfaces get lifted.
            // Sprites carry their own sector lightlevel but have no GI probe (the
            // per-triangle subsector map covers world tris only), so subId is forced
            // out of range -> gi=0 and the sector-light ambient stands in for them.
            float secLight = vb.v[i0 + 10u];                       // sector lightlevel 0..1
            vec3  ambient  = vec3(max(secLight * AMBIENT_SECTOR_SCALE, AMBIENT_FLOOR));
            uint  subId    = isSprite ? 0xFFFFFFFFu : pc.triSs.s[uint(prim)];
            vec3  gi       = (subId < pc.misc2.y) ? giIrradiance(pc.probes, subId, shadeN)
                                                  : vec3(0.0);
            L += albedo * max(gi, ambient) * ao;   // AO dims fill light only (ao fetched above)

            // DOOM-0183 L3/L5: wet sheen (direct-light specular, INV-3 — no reflection ray) on
            // nukage + goo puddles, plus a faint additive glow on goo puddles. Added AFTER
            // shadeSurface so it does not perturb diffuse GI. Puddles use the UN-rippled normal
            // `n` (a thin film, not a deep pool — no ripples, §4.6). Gated on the wet toggle.
            if (wetOn()) {
                if (nukage) L += wetSheen(hitP, shadeN);
                if (gooWet > 0.0) {
                    L += wetSheen(hitP, n) * (gooWet * kPuddleSheenScale);
                    L += kPuddleGlow * kGooColour * gooWet;
                }
            }

            // Dynamic point-light deltas (build step 5): the muzzle flash + the
            // DOOM-0044 player flashlight, each a hard ray-traced shadow composited
            // additively over the baked static (DOOM-0130 shared helpers; mode 6
            // adds the same, demodulated). Display path keeps the albedo factor.
            L += muzzleFlashDelta(shadeP, shadeN, albedo);
            L += flashlightDelta(shadeP, shadeN, albedo);

            // DOOM-0042 (Task 13): HD self-radiance on the primary hit. Added after the lit
            // terms so an emissive panel glows regardless of scene light. vec3(0) for materials
            // with no emissive map, so ordinary walls are unchanged.
            L += hdEmissive(mc, id, sUV) * kEmissiveScale;

            if (any(isnan(L)) || any(isinf(L))) L = vec3(0.0);
            if (pc.misc6.z != 0u) {                  // rb_fog strength; 0 = skip entirely (INV-8)
                FogHit fh = FogHit(hitP, n, uint(flags));
                vec4 fog = marchFog(origin, dir, tHit, fh);
                L = L * fog.a + fog.rgb;             // linear radiance, before tonemap (§4.6)
            }
            colour = toneEncode(L);
        }
        else if (mode == 5u)
        {
            // Verify accumulate (build step 4d, INV-6). Integrate DIRECT-ONLY
            // radiance (no self-emission, no GI) with the estimator in misc3.z,
            // summing spp samples into the float accum image. The host drives many
            // dispatches with advancing seed bases to converge each estimator, then
            // compares power-NEE vs brute-force for the rel-MSE bar. Writes ONLY the
            // accum image (rgb = radiance sum, a = sample count); no display output.
            int   texnum = floatBitsToInt(vb.v[i0 + 8u]);
            int   flags  = floatBitsToInt(vb.v[i0 + 9u]);
            uint  id     = isSprite ? (pc.misc4.x + uint(texnum))
                         : (((flags & FLAG_FLAT) != 0) ? (pc.misc.w + uint(texnum))
                                                       : uint(texnum));
            // Verify integrates DIRECT radiance with the geometric normal (an INV-6 math
            // self-test, not the HD look): base-UV albedo, no POM / normal / AO. Base UV is
            // computed only for an HD hit; a paletted hit samples raw hitUV (no extra work).
            MatCtrl mc  = ctrl[id];
            vec2    sUV = (mc.usePBR != 0u) ? hdBaseUV(id, hitUV, mc.uvScale) : hitUV;
            vec3    albedo = hdAlbedo(mc, id, hitUV, sUV);   // HD if usePBR, else paletted
            float tHit   = rayQueryGetIntersectionTEXT(rq, true);
            vec3  hitP   = origin + dir * tHit;

            uint  spp = pc.misc3.y;
            vec3  sum = vec3(0.0);
            for (uint si = 0u; si < spp; si++)
            {
                uint seed = pcgHash((px.x + px.y * w) * 2654435761u
                                    + pc.misc3.x + si);
                if (pc.misc3.z == 0u)
                    sum += directNEEVerify(hitP, n, albedo, pc.misc2.x, pc.misc4.y, pc.emit, seed);
                else if (pc.misc3.z == 1u)
                    sum += directAllLights(hitP, n, albedo, pc.misc2.x, pc.misc4.y, pc.emit, seed);
                else
                {
                    // White-furnace math check: one cosine bounce into a constant
                    // unit-radiance environment, albedo 1, NO occlusion (no trace).
                    // brdf*cos/pdf == 1 exactly for any direction, so a correct
                    // pdf/throughput implementation sums to spp*1.0 with zero
                    // variance; the host asserts the converged mean == 1.
                    vec3  sd   = cosineHemisphere(n, seed);
                    float cosT = max(dot(n, sd), 0.0);
                    float pdf  = cosT / PI;
                    sum += pdf > 0.0 ? (1.0 / PI) * cosT / pdf : 0.0;
                }
            }
            vec4 prev = imageLoad(accumImg, ivec2(px));
            imageStore(accumImg, ivec2(px), prev + vec4(sum, float(spp)));
            return;                                 // verify writes accum only
        }
        else if (mode == 6u)
        {
            // Denoise feed (build step 6a). Same shading as mode 4 but DEMODULATED:
            // albedo is factored out (stored separately so the spatial filter never
            // blurs texture detail) and self-emission is excluded (re-added crisp in
            // the composite). Writes the SVGF G-buffer instead of a display pixel.
            int   texnum = floatBitsToInt(vb.v[i0 + 8u]);
            int   flags  = floatBitsToInt(vb.v[i0 + 9u]);
            uint  id     = isSprite ? (pc.misc4.x + uint(texnum))
                         : (((flags & FLAG_FLAT) != 0) ? (pc.misc.w + uint(texnum))
                                                       : uint(texnum));
            // DOOM-0042 shared HD prologue (Tasks 11/14) — same as mode 4: base UV + tangent
            // frame + POM march once (usePBR-gated), every map samples the resulting `sUV`. HD
            // emissive is NOT added here; the composite keeps DOOM's per-material fullbright
            // emission (see hdEmissive). Paletted hits do no extra work (byte-identical).
            MatCtrl mc  = ctrl[id];
            vec2    sUV = hitUV;                    // paletted default (unused by the paletted branch)
            vec3    T = n, B = n;
            float   tHit = rayQueryGetIntersectionTEXT(rq, true);   // HOISTED (DOOM-0181: hitP feeds the detile world-key)
            vec3    hitP = origin + dir * tHit;                     // HOISTED
            if (mc.usePBR != 0u) {
                vec2 baseUV = hdBaseUV(id, hitUV, mc.uvScale);
                hdTangentFrame(n, p0, p1, p2, uv0, uv1, uv2, T, B);
                // DOOM-0181 L3: march POM in the de-tiled coordinate so relief registers with the
                // de-tiled albedo/normal/AO (§4.4); else the plain-space POM march.
                sUV = detileOn()
                    ? detilePOM(mc, baseUV, T, B, n, dir, detileWorldUV(hitP, n) / kDetileWorldCell)
                    : hdParallaxUV(mc, baseUV, T, B, n, dir);
            }
            // DOOM-0181 L1: de-tile the albedo (same branch as mode 4) before galbedo is stored.
            vec3 albedo;
            if (mc.usePBR != 0u && mc.maps[0] >= 0 && detileOn()) {
                vec2 g = detileWorldUV(hitP, n) / kDetileWorldCell;
                albedo = detile(uint(mc.maps[0]), sUV, g);
            } else {
                albedo = hdAlbedo(mc, id, hitUV, sUV);   // HD if usePBR, else paletted
            }
            // DOOM-0181 L4: AO fetched ONCE here (de-tiled; §4.3) for the crevice-pooled filth and
            // the ambient term below. Computed before the half-res early-return so every stored
            // galbedo carries the filth (the 3/4 reconstructed pixels need it too); the one extra
            // AO fetch on those pixels is the cost of baking filth into the demodulated albedo.
            float ao = (mc.usePBR != 0u && mc.maps[4] >= 0 && detileOn())
                     ? detileR(uint(mc.maps[4]), sUV, detileWorldUV(hitP, n) / kDetileWorldCell)
                     : hdAO(mc, id, sUV);
            // DOOM-0179/0181 grime + filth, applied BEFORE galbedo is stored so the composite's
            // re-modulation (L = albedo*illum) carries the mottle. n is geometric here.
            float gooWet = 0.0;   // DOOM-0183 L5: goo-puddle wet coverage (0 unless a green-goo puddle)
            if (!isSprite && filthOn()) albedo = applyGrime(albedo, hitP, n, ao, gooWet);   // DOOM-0179/0181 filth (all world surfaces; misc5.w toggle)

            // build step 6c (half-resolution lighting): the G-buffer (position /
            // normal / albedo) is written at FULL resolution for EVERY pixel — it
            // carries the sharp edges the denoiser upsample and demodulation lean on.
            // The expensive part — the live direct/NEE shadow rays + the muzzle-flash
            // shadow ray — is the half-res lever: only the even/even pixel of each 2x2
            // block casts it. The other three pixels are reconstructed in the temporal
            // pass from these grid samples, guided by this full-res G-buffer. gillum.a
            // flags a real sample (1) vs a pixel to reconstruct (0).
            // DOOM-0084: galbedo.a carries the self-emission ENABLE (1 = world surface
            // or a fullbright light sprite; 0 = a non-light sprite — pickup/monster),
            // so the composite re-adds emission only where it belongs.
            bool addEmis = isSprite ? ((flags & FLAG_EMISSIVE) != 0) : true;
            uint par = pc.misc3.w;
            imageStore(gpos[par],  ivec2(px), vec4(hitP, float(id)));
            imageStore(gnorm[par], ivec2(px), vec4(n, 0.0));
            imageStore(galbedo,    ivec2(px), vec4(albedo, addEmis ? 1.0 : 0.0));
            if (((px.x | px.y) & 1u) != 0u) {       // not an even/even grid sample
                imageStore(gillum, ivec2(px), vec4(0.0));
                return;
            }

            // DOOM-0011 L1: half-res fog march, one sample per 2x2 grid block (mirrors
            // the shadow-ray half-res gate above). rb_fog-gated (INV-8); when off, store
            // the neutral no-fog value so the composite fetch is a byte-identical no-op.
            if (pc.misc6.z != 0u) {
                FogHit fh = FogHit(hitP, n, uint(flags));
                vec4 fog = marchFog(origin, dir, tHit, fh);
                imageStore(fogImg, ivec2(px) / 2, fog);
            } else {
                imageStore(fogImg, ivec2(px) / 2, vec4(0.0, 0.0, 0.0, 1.0));
            }

            // Direct NEE with albedo 1 + no emission -> the pure incident/PI direct
            // irradiance; baked GI irradiance is already albedo-free; the muzzle
            // flash term likewise without albedo. albedo/emission ride separately.
            // Seed folds in the frame counter (misc3.x) so each frame is an
            // INDEPENDENT sample -> temporal accumulation converges and the SVGF
            // variance estimate is non-zero (a frozen seed defeats the denoiser).
            uint seed  = pcgHash(px.x + px.y * w + 1u + pc.misc3.x * 2654435761u);
            // DOOM-0119: hit sector for the REJECT light cull (see the mode-4 path).
            uint hitSec = 0xFFFFFFFFu;
            if (pc.misc4.z > 0u && !isSprite)
            {
                uint ss = pc.triSs.s[uint(prim)];
                if (ss < pc.misc2.y) hitSec = pc.subSec.s[ss];
            }
            // Lighting uses the normal-mapped shading normal; the G-buffer normal above
            // stays GEOMETRIC (the SVGF edge-stopping wants low-frequency normals, not the
            // high-frequency map detail, or it treats bumps as edges and under-denoises).
            // DOOM-0181 L2: de-tile the normal in lockstep with the albedo (same world cell), so a
            // mirrored/offset tile's relief matches its colour. INV-2: detileNormalTS negates the
            // per-cell tangent-X on a mirror. Paletted / no-normal-map hits keep hdShadingNormal.
            vec3 shadeN;
            if (mc.usePBR != 0u && mc.maps[1] >= 0 && detileOn()) {
                vec2 gN = detileWorldUV(hitP, n) / kDetileWorldCell;
                vec3 tn = detileNormalTS(uint(mc.maps[1]), sUV, gN);
                shadeN  = normalize(tn.x * T + tn.y * B + tn.z * n);
            } else {
                shadeN = hdShadingNormal(mc, id, sUV, n, T, B);
            }
            // Geometric shadow-origin lift for normal-mapped surfaces (see mode 4); gpos
            // above stored the TRUE hitP, so only the shadow rays use the lifted point.
            vec3 shadeP = (mc.usePBR != 0u && mc.maps[1] >= 0) ? hitP + n * 2e-3 : hitP;
            // DOOM-0183 L4: nukage ripples the LIGHTING normal (INV-4). The G-buffer normal
            // (gnorm, stored above) stays GEOMETRIC — only this shading normal wobbles.
            bool nukage = isNukage(mc);
            if (nukage && wetOn()) shadeN = rippleNormal(shadeN, hitP.xy, rippleTime());
            vec3 illum = shadeSurface(shadeP, shadeN, vec3(1.0), id, pc.misc2.x, pc.misc4.y,
                                      pc.emit, pc.matEmis, NEE_SAMPLES, false,
                                      hitSec, pc.misc4.z, pc.emitSec, pc.reject, seed);
            // GI bounce + DOOM-0043 sector-light ambient floor (demodulated: the
            // composite re-applies albedo). Same max() floor as mode 4 so a bright-
            // marked but unlit room reads, while dark sectors stay dark.
            float secLight = vb.v[i0 + 10u];                       // sector lightlevel 0..1
            vec3  ambient  = vec3(max(secLight * AMBIENT_SECTOR_SCALE, AMBIENT_FLOOR));
            uint  subId    = isSprite ? 0xFFFFFFFFu : pc.triSs.s[uint(prim)];  // sprites: no GI probe
            vec3  gi       = (subId < pc.misc2.y) ? giIrradiance(pc.probes, subId, shadeN)
                                                  : vec3(0.0);
            illum += max(gi, ambient) * ao;   // AO dims fill light only (ao fetched above)

            // DOOM-0183 L3/L5: wet sheen + goo-puddle glow, mirroring the mode-4 block. NOTE: this
            // path is DEMODULATED (svgf_composite re-applies albedo), so the sheen/glow are tinted
            // by the surface albedo downstream. For the green liquid this reads as a bright GREEN
            // wet glint — on-theme; a neutral wet surface (water, deferred) would need a separate
            // full-res specular channel (a DOOM-0103 follow-up). Half-res: computed on the grid
            // sample pixels only (the early-return above skips the other 3/4), reconstructed by SVGF.
            if (wetOn()) {
                if (nukage) illum += wetSheen(hitP, shadeN);
                if (gooWet > 0.0) {
                    illum += wetSheen(hitP, n) * (gooWet * kPuddleSheenScale);
                    illum += kPuddleGlow * kGooColour * gooWet;
                }
            }

            // Muzzle flash + DOOM-0044 flashlight, demodulated (the composite re-
            // applies albedo). DOOM-0130 shared helpers — passing vec3(1.0) strips
            // the albedo bit-exactly (1.0*x == x), matching the pre-refactor feed.
            illum += muzzleFlashDelta(shadeP, shadeN, vec3(1.0));
            illum += flashlightDelta(shadeP, shadeN, vec3(1.0));

            if (any(isnan(illum)) || any(isinf(illum))) illum = vec3(0.0);
            imageStore(gillum, ivec2(px), vec4(illum, 1.0));
            return;                                 // feed writes the G-buffer only
        }
        else
        {
            colour = n * 0.5 + 0.5;                 // intersection / normal view
        }
    }
    else
    {
        // Miss OR sky-backdrop hit (DOOM-0141): both render the DOOM sky. Mode 5
        // (verify) leaves the accum texel untouched (count stays 0 -> the host skips
        // background pixels). Furnace mode keeps unit radiance (energy flat across hit
        // and miss). Modes 4/6 render the real sky panorama (the mountains), DISPLAY-
        // encoded and output WITHOUT tonemap so the traced sky matches the Solid/raster
        // sky; the intersection debug view keeps a flat dark sky.
        if      (mode == 5u) return;
        else if (mode == 6u)
        {
            // Sky in the denoise feed: matId < 0 flags it; the stored sky colour passes
            // through the denoiser and the composite emits it raw (no tonemap).
            uint par = pc.misc3.w;
            imageStore(gpos[par],  ivec2(px), vec4(0.0, 0.0, 0.0, -1.0));
            imageStore(gnorm[par], ivec2(px), vec4(0.0, 0.0, 1.0, 0.0));
            imageStore(galbedo,    ivec2(px), vec4(0.0));
            imageStore(gillum,     ivec2(px), vec4(skyPanorama(px, w, h), 0.0));
            // DOOM-0011 L1b §4.6a: the sky backdrop is open-sky by definition (constant
            // outdoor density over the whole view distance), so a CLOSED FORM is exact --
            // no second march loop. Half-res, one write per 2x2 grid block (mirrors the
            // surface path's even/even gate above); svgf_composite.comp has no pt_common
            // consts, so the value must be computed here. The EXISTING fetchFogBilinear
            // fold on the sky-passthrough branch (svgf_composite.comp:100-103, unchanged)
            // picks it up with no further wiring.
            if (pc.misc6[2] != 0u && ((px.x | px.y) & 1u) == 0u) {
                float strength  = fogStrengthScale(pc.misc6.z);
                float trans     = exp(-kFogBaseDensity * strength * kFogMaxDist);
                vec3  inscatter = SKY_COLOR * (1.0 - trans);
                imageStore(fogImg, ivec2(px) / 2, vec4(inscatter, trans));
            }
            return;
        }
        else if (mode == 2u) colour = vec3(1.0);
        else if (mode == 4u)
        {
            colour = skyPanorama(px, w, h);
            // DOOM-0011 L1b §4.6a: same closed-form aerial fog as the mode-6 sky branch
            // above (open sky = constant outdoor density over the whole view distance).
            // Full-res here (mode 4 has no half-res grid to gate on).
            if (pc.misc6[2] != 0u) {
                float strength = fogStrengthScale(pc.misc6.z);
                float trans    = exp(-kFogBaseDensity * strength * kFogMaxDist);
                colour = colour * trans + SKY_COLOR * (1.0 - trans);   // aerial haze on the mountains
            }
        }
        else                 colour = vec3(0.02, 0.02, 0.05);
    }

    imageStore(outImg, ivec2(px), vec4(colour, 1.0));
}
