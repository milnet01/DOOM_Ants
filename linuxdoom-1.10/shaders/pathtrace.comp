#version 460
//
// DOOM-0009 path tracer — build steps 2c/3a/3c.
//
// A compute megakernel that casts one primary ray per pixel against the level
// TLAS (built in step 2b) via VK_KHR_ray_query, and writes an image the present
// path blits to the swapchain. Modes 1-3 are diagnostics; mode 4 is the first
// real lit output. Selected by the host (the `~` debug toggle, off -> 1..4):
//
//   mode 1  INTERSECTION  — traversal + camera sanity. On a hit, colour by the
//                           surface normal (n*0.5+0.5); on a miss, a dark sky.
//                           Should line up face-for-face with the raster view.
//   mode 2  WHITE FURNACE  — energy sanity for the sampling math step 3 reuses.
//                           Every hit does one cosine-weighted diffuse bounce
//                           into a constant unit-radiance environment with
//                           albedo 1 and NO occlusion: the estimator
//                           brdf*cos/pdf = albedo = 1 exactly, with zero
//                           variance. So a correct integrator paints the whole
//                           screen flat white; any tint/banding is an energy
//                           bug in the pdf/throughput code.
//   mode 3  TEXTURED       — build step 3a: fetch the hit surface's real DOOM
//                           material (paletted texture decoded through PLAYPAL,
//                           exactly as the raster mesh.frag does) and modulate by
//                           sector lightlevel. The honest "albedo recovered +
//                           sector-light seed" view; real NEE direct lighting
//                           replaces the flat sector-light term in step 3c.
//   mode 4  NEE DIRECT    — build step 3c: linear albedo + the surface's own
//                           emission, plus direct light estimated by shadow-
//                           sampling the step-3b emitter list (hard ray-traced
//                           shadows), a flat sky ambient standing in for the
//                           step-4 GI bake, Reinhard-tonemapped. The first lit
//                           image: lamps/screens/slime/lit switches cast light.
//
#extension GL_EXT_ray_query              : require
#extension GL_EXT_buffer_reference       : require
#extension GL_EXT_scalar_block_layout    : require
#extension GL_EXT_nonuniform_qualifier   : require
#extension GL_GOOGLE_include_directive    : require   // shared pt_common.glsl

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT topAS;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D outImg;
// Float accumulation target for the INV-6 verify path (build step 4d, mode 5).
// Carries running sums: rgb = summed direct-only radiance, a = sample count. Read
// back on the host to form converged images. Untouched by the display modes 1-4.
layout(set = 0, binding = 2, rgba32f) uniform image2D accumImg;

// SVGF denoiser feed (set 2; DOOM-0009 build step 6). Mode 6 writes the G-buffer
// the temporal/a-trous/composite passes consume instead of a tonemapped pixel:
// world position+matId, world normal, surface albedo, and the noisy albedo-
// DEMODULATED illumination. gpos/gnorm ping-pong by frame parity (pc.misc3.w):
// mode 6 writes [cur]; the temporal pass reprojects last frame's [prev]. Only the
// feed half of the set is declared here (the denoiser passes declare the rest).
layout(set = 2, binding = 0, rgba32f) uniform writeonly image2D gpos[2];   // worldPos.xyz, .w = matId (<0 sky)
layout(set = 2, binding = 1, rgba16f) uniform writeonly image2D gnorm[2];  // world normal.xyz
layout(set = 2, binding = 2, rgba16f) uniform writeonly image2D galbedo;   // surface albedo.rgb
layout(set = 2, binding = 3, rgba16f) uniform writeonly image2D gillum;    // demodulated noisy illum

// Materials (set 1) — shared verbatim with the raster pass (r_vulkan.cpp
// CreateDescriptors / mesh.frag): the 256x1 PLAYPAL LUT and the bindless array of
// R8 palette-index material images. Same binding numbers (0, 2) and the same
// g.ds set bound at trace time, so the traced surface decodes to DOOM's exact
// colours with no parallel material path.
layout(set = 1, binding = 0) uniform sampler2D paletteTex;
layout(set = 1, binding = 2) uniform sampler2D materialTex[];

// The level mesh, the step-3b emitter list, and the per-material Le table are read
// by GPU address (buffer_reference). Their buffer layouts + the shared albedo
// decode and NEE direct-lighting math live in pt_common.glsl, #included verbatim
// by the GI bake (bake.comp) too, so the baked bounce and the directly-traced
// frame agree on what each surface reflects.
#include "pt_common.glsl"

// Tone pipeline (build step 4b-iii). The scalar curves come from the Vestige
// Formula Workbench export (exposureEv, linearToSrgb in formulas.glsl); the
// PBR-Neutral operator is the hand-written non-scalar routine. This retires the
// inline EXPOSURE=4.0 + Reinhard + pow(1/2.2) hack (INV-7 backfill paid down).
#include "formulas/formulas.glsl"
#include "formulas/pbr_neutral_tonemap.glsl"

layout(push_constant) uniform PC {
    vec4  camPos;    // xyz = ray origin (world); w = sub-pixel jitter X (6-d)
    vec4  camDir;    // xyz = forward;            w = sub-pixel jitter Y (6-d)
    vec4  camRight;  // xyz = right,  w = tan(hFov/2)
    vec4  camUp;     // xyz = up,     w = tan(vFov/2)
    uvec4 misc;      // x = mode, y = width, z = height, w = numWall (flat-id offset)
    uvec4 misc2;     // x = emitter count (3b); y = probe count (4c); z,w reserved
    uvec4 misc3;     // step-4d verify: x = sample-seed base, y = spp this dispatch,
                     // z = estimator (0 = power-NEE, 1 = brute-force), w reserved
    uvec4 misc4;     // DOOM-0100: x = sprite material base (numWall+numFlat); rest reserved
    Verts    verts;    // level mesh vertex buffer (device address)
    Emitters emit;     // step-3b emitter list (device address; count in misc2.x)
    MatEmis  matEmis;  // per-material Le table (device address)
    ProbesRO probes;   // step-4 baked GI cache (device address; count in misc2.y)
    TriSs    triSs;     // per-triangle subsector id -> probe index (device address)
    Verts    spriteVerts; // DOOM-0100: per-frame billboard verts (device address; 0 if none)
} pc;

// --- Camera-only shading constants (build step 3c/4b-iii) --------------------
const uint  NEE_SAMPLES = 6u;          // shadow rays/pixel. Emitters are picked by
                                       // POWER (3c-2, cdf binary search), so a few
                                       // samples land on the lights that matter. Raised
                                       // 4->6 in step 6c: the half-res lighting trace
                                       // casts these for only 1/4 of pixels, so 6 still
                                       // costs less than the old full-res 4 — spend the
                                       // freed budget on cleaner input (less source noise).
const float AMBIENT_FLOOR = 0.02;      // tiny fill for a triangle with no GI probe
                                       // (untagged) so it isn't pure black — the
                                       // step-4 probe bounce is the real fill now.
// DOOM-0043 (Ultra-only — only this megakernel runs it; Solid is the raster path):
// a gentle ambient floor that scales with the surface's DOOM sector lightlevel
// (per-vertex, 0..1). A sector the mapper marked bright reads as lit even with no
// emissive lamp texture; a dark sector stays dark so the flashlight (DOOM-0044)
// has somewhere to matter. INV-7 inline tunable — this is the playtest brightness
// knob (the feature is provisional pending playtest, per the DOOM-0043 roadmap).
const float AMBIENT_SECTOR_SCALE = 0.25;   // bright sector (light=1) -> 0.25 linear fill
// Exposure as a photographic EV (the Workbench exposureEv curve turns it into a
// linear gain: 1/(2^EV * 1.2)). -2.25 ≈ the old 4.0 gain, so this swap changes the
// tone *operator* without an exposure jump; the value gets its real tune in step 4c
// once the GI bake feeds the frame and the radiance levels settle.
const float EXPOSURE_EV   = -2.25;

// Muzzle-flash dynamic light (build step 5). A positional point light at the gun,
// active only while firing (the host passes player->extralight in misc2.z). Offset
// FORWARD + DROP from the eye so it sits at the barrel: as the player turns, the
// muzzle swings around the eye and its hard shadow tracks with it (a positionless
// screen-brighten could not). INV-7 backfill constants (inline, like the step-3
// scene-light values) pending a Workbench pass: warm flash colour, a radiant scale
// tuned for DOOM-unit 1/dist^2 falloff, and the barrel offset in world units.
const vec3  FLASH_COLOR     = vec3(1.0, 0.85, 0.6);
const float FLASH_INTENSITY = 3.0e6;   // the host gates this by extralight, which is only
                                       // 1or2 * 16/255 = 0.063/0.125 (A_Light1/2), so the
                                       // EFFECTIVE radiance is ~8-16x lower than the raw value.
                                       // At 3e6 a single flash (A_Light1) lands ~1.9e5 effective
                                       // -- ~3x the flashlight's 6e4 -- so a gunshot clearly
                                       // out-shines the headlamp and lights the whole room; the
                                       // big flash (A_Light2) is ~6x. A brief blinding burst when
                                       // firing point-blank is intended (it is a 1-2 frame flash).
const float FLASH_RADIUS2   = 1.5e4;   // (~122 u)^2 near-field softening (same idea as the
                                       // flashlight): caps the 1/dist^2 peak so firing with
                                       // the barrel against a wall doesn't blow out to white.
const float MUZZLE_FORWARD  = 24.0;
const float MUZZLE_DROP     = 8.0;

// Player flashlight / headlamp (DOOM-0044). A spotlight at the eye, aimed along
// the view direction (camPos/camDir already carry both), toggled by the player
// (the host forwards the on/off bit in misc2.w). Same hard ray-traced shadow +
// DOOM-unit 1/dist^2 falloff as the muzzle flash, plus a cone so it reads as a
// focused beam: full-bright inside ~23 deg, falling to zero by ~35 deg off-axis.
// Warm-white beam. INV-7 inline tunables (the cone + intensity get their real
// tune in a Workbench pass, like the muzzle-flash and scene-light constants).
const vec3  FLASHLIGHT_COLOR     = vec3(1.0, 0.97, 0.88);
const float FLASHLIGHT_INTENSITY = 6.0e4;
const float FLASHLIGHT_COS_IN    = 0.92;   // cos(~23 deg): full-bright cone core
const float FLASHLIGHT_COS_OUT   = 0.82;   // cos(~35 deg): beam edge fades to 0
const float FLASHLIGHT_RADIUS2   = 2.5e4;  // (~158 u)^2 near-field softening: the falloff
                                           // becomes 1/(dist^2 + R^2), so the 1/dist^2 term
                                           // can't blow up to a white blob when the player is
                                           // right against a wall. Caps the near-field peak
                                           // while leaving the mid/far gradient intact.

// Display tone map: lift by exposure, compress HDR->[0,1] with the hue-preserving
// Khronos PBR-Neutral operator (keeps DOOM's saturated palette where Reinhard/ACES
// would wash it out), then sRGB-encode per channel for the UNORM swapchain.
vec3 toneEncode(vec3 L)
{
    L = max(L, vec3(0.0)) * exposureEv(EXPOSURE_EV);
    L = pbrNeutralToneMapping(L);
    return vec3(linearToSrgb(L.r), linearToSrgb(L.g), linearToSrgb(L.b));
}

// DOOM-0100: a sprite billboard candidate is "opaque" (a real hit) only where its
// paletted texel is not index 0 (the transparent cut-out key). The sprite BLAS is
// the only NON-opaque geometry, so every triangle candidate the trace yields is a
// sprite: sample its texel at the candidate's barycentric UV and report whether the
// ray should commit here. Mirrors the raster sprite alpha-test (mesh.frag) and the
// world decode (same 18-float rb_vertex_t layout; UV at [6,7], material id at [8]).
bool spriteCandidateOpaque(rayQueryEXT rq)
{
    int  prim = rayQueryGetIntersectionPrimitiveIndexEXT(rq, false);
    vec2 bc   = rayQueryGetIntersectionBarycentricsEXT(rq, false);
    uint i0   = uint(prim) * 3u * 18u;
    int  texnum = floatBitsToInt(pc.spriteVerts.v[i0 + 8u]);
    vec2 uv = (1.0 - bc.x - bc.y) * vec2(pc.spriteVerts.v[i0 +  6u], pc.spriteVerts.v[i0 +  7u])
            +          bc.x        * vec2(pc.spriteVerts.v[i0 + 24u], pc.spriteVerts.v[i0 + 25u])
            +          bc.y        * vec2(pc.spriteVerts.v[i0 + 42u], pc.spriteVerts.v[i0 + 43u]);
    uint  id  = pc.misc4.x + uint(texnum);
    vec2  sz  = vec2(textureSize(materialTex[nonuniformEXT(id)], 0));
    float idx = texture(materialTex[nonuniformEXT(id)], uv / sz).r * 255.0;
    return idx >= 0.5;            // palette index 0 == transparent
}

void main()
{
    const uvec2 px = gl_GlobalInvocationID.xy;
    const uint  w  = pc.misc.y;
    const uint  h  = pc.misc.z;
    if (px.x >= w || px.y >= h)
        return;

    // Primary ray: pixel centre -> NDC [-1,1], screen-y down so world up = -ndcY.
    // build step 6-d: an optional sub-pixel jitter (camPos.w / camDir.w, in render
    // pixels) shifts the sample point each frame so the temporal upscaler (TAAU/FSR)
    // reconstructs sub-pixel detail. Zero on the non-upscaled path, so the ray is
    // the exact pixel centre as before.
    const float ndcX = (2.0 * (float(px.x) + 0.5 + pc.camPos.w) / float(w)) - 1.0;
    const float ndcY = (2.0 * (float(px.y) + 0.5 + pc.camDir.w) / float(h)) - 1.0;
    const vec3  origin = pc.camPos.xyz;
    const vec3  dir = normalize(pc.camDir.xyz
                              + pc.camRight.xyz * (ndcX * pc.camRight.w)
                              + pc.camUp.xyz    * (-ndcY * pc.camUp.w));

    const uint mode = pc.misc.x;

    rayQueryEXT rq;
    // DOOM-0100: drop gl_RayFlagsOpaqueEXT. The world BLAS is OPAQUE_BIT (auto-
    // commits with no candidate), while the sprite BLAS is non-opaque and yields
    // triangle candidates we alpha-test against the billboard's cut-out key.
    rayQueryInitializeEXT(rq, topAS, gl_RayFlagsNoneEXT, 0xFFu,
                          origin, 0.01, dir, 1.0e9);
    while (rayQueryProceedEXT(rq)) {
        if (rayQueryGetIntersectionTypeEXT(rq, false)
            == gl_RayQueryCandidateIntersectionTriangleEXT)
        {
            // Only the sprite BLAS is non-opaque, so any triangle candidate is a
            // sprite: commit it as the hit only where its texel is not cut out.
            if (spriteCandidateOpaque(rq))
                rayQueryConfirmIntersectionEXT(rq);
        }
    }

    vec3 colour;
    if (rayQueryGetIntersectionTypeEXT(rq, true)
        == gl_RayQueryCommittedIntersectionTriangleEXT)
    {
        // DOOM-0100: a hit is either the static world (instance 0) or a billboard
        // sprite (instance 1). Both share the rb_vertex_t layout (18 floats/vertex),
        // so select the matching vertex buffer and decode identically below.
        const bool isSprite = rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true) == 1;
        Verts vb = isSprite ? pc.spriteVerts : pc.verts;

        // Baked normal from the hit triangle's first vertex (flat-shaded world faces
        // share one normal across the face; sprite billboards bake a camera-facing
        // normal). Non-indexed soup, so vertex 0 of triangle p is at p*3.
        const int  prim = rayQueryGetIntersectionPrimitiveIndexEXT(rq, true);
        const uint i0   = uint(prim) * 3u * 18u;   // 18 floats/vertex
        vec3 n = vec3(vb.v[i0 + 3u], vb.v[i0 + 4u], vb.v[i0 + 5u]);
        n = normalize(n);
        if (dot(n, dir) > 0.0) n = -n;             // face the viewer

        // Barycentric-interpolate the hit's texture coords across the triangle. DOOM
        // faces are flat-SHADED (one normal per face, shared above), but a textured
        // surface's UVs VARY per vertex — sampling only vertex 0's UV for the whole
        // triangle (as the normal is shared) paints each face a single flat colour
        // (no texture). The rasteriser interpolates UVs for free; the tracer must do
        // it explicitly from the hit barycentrics. 18 floats/vertex, UV at [6,7].
        vec2 bc = rayQueryGetIntersectionBarycentricsEXT(rq, true);
        vec2 hitUV = (1.0 - bc.x - bc.y) * vec2(vb.v[i0 +  6u], vb.v[i0 +  7u])
                   +          bc.x        * vec2(vb.v[i0 + 24u], vb.v[i0 + 25u])
                   +          bc.y        * vec2(vb.v[i0 + 42u], vb.v[i0 + 43u]);

        if (mode == 2u)
        {
            // White furnace: one cosine-weighted bounce, constant env L = 1,
            // albedo = 1, no occlusion. weight = brdf*cos/pdf = albedo, exactly.
            uint  seed = px.x + px.y * w;
            float u1 = rnd(seed), u2 = rnd(seed);
            vec3  t  = normalize(cross(abs(n.z) < 0.999 ? vec3(0,0,1) : vec3(1,0,0), n));
            vec3  b  = cross(n, t);
            float r  = sqrt(u1), phi = 2.0 * PI * u2;
            vec3  sd = t * (r * cos(phi)) + b * (r * sin(phi)) + n * sqrt(max(0.0, 1.0 - u1));
            float cosT = max(dot(n, sd), 0.0);
            float pdf  = cosT / PI;
            float brdf = 1.0 / PI;                  // albedo 1 Lambert
            float L    = 1.0;
            colour = vec3(pdf > 0.0 ? (brdf * cosT / pdf) * L : 0.0);
        }
        else if (mode == 3u)
        {
            // Textured (3a): decode the hit surface's DOOM material exactly as the
            // raster path (mesh.frag) does, then modulate by sector lightlevel.
            // Per-vertex data of the hit triangle's vertex 0 (flat-shaded faces
            // share it across all three vertices, like the normal above).
            int   texnum = floatBitsToInt(vb.v[i0 + 8u]);
            int   flags  = floatBitsToInt(vb.v[i0 + 9u]);
            float light  = vb.v[i0 + 10u];

            // Unified bindless id: sprites sit after the flats (offset misc4.x =
            // numWall+numFlat); flats sit after the walls (offset numWall); walls
            // (including two-sided masked mid-walls) index by texnum direct.
            int  id    = isSprite ? (int(pc.misc4.x) + texnum)
                       : (((flags & FLAG_FLAT) != 0) ? (int(pc.misc.w) + texnum) : texnum);
            vec2 sz    = vec2(textureSize(materialTex[nonuniformEXT(id)], 0));
            float idx  = texture(materialTex[nonuniformEXT(id)], hitUV / sz).r * 255.0;
            vec3 albedo = texture(paletteTex, vec2((idx + 0.5) / 256.0, 0.5)).rgb;

            colour = albedo * light;                // sector-light seed; NEE in 3c
        }
        else if (mode == 4u)
        {
            // NEE direct lighting (build step 3c). Decode the surface albedo into
            // linear space, then shade it (self-emission + power-importance NEE
            // direct, hard shadows) via the shared shadeSurface() — the SAME math
            // the GI bake runs at each probe-ray hit. A flat sky/sector ambient
            // stands in for the step-4 GI bake so lamp-less rooms aren't pure black.
            int   texnum = floatBitsToInt(vb.v[i0 + 8u]);
            int   flags  = floatBitsToInt(vb.v[i0 + 9u]);
            uint  id     = isSprite ? (pc.misc4.x + uint(texnum))
                         : (((flags & FLAG_FLAT) != 0) ? (pc.misc.w + uint(texnum))
                                                       : uint(texnum));
            vec3  albedo = decodeAlbedo(id, hitUV);

            float tHit = rayQueryGetIntersectionTEXT(rq, true);
            vec3  hitP = origin + dir * tHit;

            // DOOM-0084: world surfaces self-emit as before; a sprite self-emits only
            // if it's a fullbright light Thing (lamp/torch/barrel), so ammo pickups and
            // monsters don't glow. The per-texel value mask in shadeSurface then keeps
            // the glow on the bright pixels (lamp top, not the dark stand).
            bool addEmis = isSprite ? ((flags & FLAG_EMISSIVE) != 0) : true;
            uint seed = px.x + px.y * w + 1u;
            vec3 L = shadeSurface(hitP, n, albedo, id, pc.misc2.x,
                                  pc.emit, pc.matEmis, NEE_SAMPLES, addEmis, seed);

            // Indirect GI (build step 4c) + DOOM-0043 sector-light ambient floor.
            // The probe holds the bounced solution; the floor is a deliberate,
            // designer-driven ambient seeded by the sector lightlevel (§4.2). max()
            // keeps GI wherever it already exceeds the floor, so lit rooms are
            // untouched (no double-count) and only dim/unprobed surfaces get lifted.
            // Sprites carry their own sector lightlevel but have no GI probe (the
            // per-triangle subsector map covers world tris only), so subId is forced
            // out of range -> gi=0 and the sector-light ambient stands in for them.
            float secLight = vb.v[i0 + 10u];                       // sector lightlevel 0..1
            vec3  ambient  = vec3(max(secLight * AMBIENT_SECTOR_SCALE, AMBIENT_FLOOR));
            uint  subId    = isSprite ? 0xFFFFFFFFu : pc.triSs.s[uint(prim)];
            vec3  gi       = (subId < pc.misc2.y) ? giIrradiance(pc.probes, subId, n)
                                                  : vec3(0.0);
            L += albedo * max(gi, ambient);

            // Dynamic delta (build step 5): the muzzle flash. A point light at the
            // gun barrel (eye + forward/drop offset) while firing, with a hard
            // ray-traced shadow, composited additively over the baked static. The
            // offset makes the muzzle swing as the player turns, so the cast shadow's
            // direction tracks it (the verify a positionless brighten would fail).
            float flash = uintBitsToFloat(pc.misc2.z);
            if (flash > 0.0)
            {
                vec3  muzzle = pc.camPos.xyz + pc.camDir.xyz * MUZZLE_FORWARD
                             + vec3(0.0, 0.0, -MUZZLE_DROP);
                vec3  md    = muzzle - hitP;
                float mdist2 = dot(md, md);
                float mdist  = sqrt(mdist2);
                vec3  mwi    = md / mdist;
                float mcos   = dot(n, mwi);
                if (mcos > 0.0 && mdist2 > 1.0)
                {
                    rayQueryEXT sq;
                    rayQueryInitializeEXT(sq, topAS,
                        gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT, 0x01u,
                        hitP + n * 1e-3, 1e-3, mwi, mdist - 2e-3);
                    while (rayQueryProceedEXT(sq)) {}
                    if (rayQueryGetIntersectionTypeEXT(sq, true)
                        == gl_RayQueryCommittedIntersectionNoneEXT)
                        L += albedo * (1.0 / PI) * FLASH_COLOR
                             * (flash * FLASH_INTENSITY) * mcos
                             / (mdist2 + FLASH_RADIUS2);
                }
            }

            // DOOM-0044: the player flashlight (headlamp). A spotlight at the eye
            // aimed along the view, gated by the rb_flashlight toggle (misc2.w),
            // with the same hard ray-traced shadow + 1/dist^2 falloff as the muzzle
            // flash plus a cone attenuation. The lamp sits at the eye, so the shade
            // ray runs surface->eye; the cone tests how closely that hugs camDir.
            if (pc.misc2.w != 0u)
            {
                vec3  fl    = pc.camPos.xyz - hitP;     // surface -> eye (the lamp)
                float fl2   = dot(fl, fl);
                float fdist = sqrt(fl2);
                vec3  fwi   = fl / fdist;
                float fcos  = dot(n, fwi);
                float spot  = smoothstep(FLASHLIGHT_COS_OUT, FLASHLIGHT_COS_IN,
                                         dot(-fwi, pc.camDir.xyz));
                if (fcos > 0.0 && spot > 0.0 && fl2 > 1.0)
                {
                    rayQueryEXT sq;
                    rayQueryInitializeEXT(sq, topAS,
                        gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT, 0x01u,
                        hitP + n * 1e-3, 1e-3, fwi, fdist - 2e-3);
                    while (rayQueryProceedEXT(sq)) {}
                    if (rayQueryGetIntersectionTypeEXT(sq, true)
                        == gl_RayQueryCommittedIntersectionNoneEXT)
                        L += albedo * (1.0 / PI) * FLASHLIGHT_COLOR
                             * (FLASHLIGHT_INTENSITY * spot) * fcos
                             / (fl2 + FLASHLIGHT_RADIUS2);
                }
            }

            if (any(isnan(L)) || any(isinf(L))) L = vec3(0.0);
            colour = toneEncode(L);
        }
        else if (mode == 5u)
        {
            // Verify accumulate (build step 4d, INV-6). Integrate DIRECT-ONLY
            // radiance (no self-emission, no GI) with the estimator in misc3.z,
            // summing spp samples into the float accum image. The host drives many
            // dispatches with advancing seed bases to converge each estimator, then
            // compares power-NEE vs brute-force for the rel-MSE bar. Writes ONLY the
            // accum image (rgb = radiance sum, a = sample count); no display output.
            int   texnum = floatBitsToInt(vb.v[i0 + 8u]);
            int   flags  = floatBitsToInt(vb.v[i0 + 9u]);
            uint  id     = isSprite ? (pc.misc4.x + uint(texnum))
                         : (((flags & FLAG_FLAT) != 0) ? (pc.misc.w + uint(texnum))
                                                       : uint(texnum));
            vec3  albedo = decodeAlbedo(id, hitUV);
            float tHit   = rayQueryGetIntersectionTEXT(rq, true);
            vec3  hitP   = origin + dir * tHit;

            uint  spp = pc.misc3.y;
            vec3  sum = vec3(0.0);
            for (uint si = 0u; si < spp; si++)
            {
                uint seed = pcgHash((px.x + px.y * w) * 2654435761u
                                    + pc.misc3.x + si);
                if (pc.misc3.z == 0u)
                    sum += directNEEVerify(hitP, n, albedo, pc.misc2.x, pc.emit, seed);
                else if (pc.misc3.z == 1u)
                    sum += directAllLights(hitP, n, albedo, pc.misc2.x, pc.emit, seed);
                else
                {
                    // White-furnace math check: one cosine bounce into a constant
                    // unit-radiance environment, albedo 1, NO occlusion (no trace).
                    // brdf*cos/pdf == 1 exactly for any direction, so a correct
                    // pdf/throughput implementation sums to spp*1.0 with zero
                    // variance; the host asserts the converged mean == 1.
                    vec3  sd   = cosineHemisphere(n, seed);
                    float cosT = max(dot(n, sd), 0.0);
                    float pdf  = cosT / PI;
                    sum += pdf > 0.0 ? (1.0 / PI) * cosT / pdf : 0.0;
                }
            }
            vec4 prev = imageLoad(accumImg, ivec2(px));
            imageStore(accumImg, ivec2(px), prev + vec4(sum, float(spp)));
            return;                                 // verify writes accum only
        }
        else if (mode == 6u)
        {
            // Denoise feed (build step 6a). Same shading as mode 4 but DEMODULATED:
            // albedo is factored out (stored separately so the spatial filter never
            // blurs texture detail) and self-emission is excluded (re-added crisp in
            // the composite). Writes the SVGF G-buffer instead of a display pixel.
            int   texnum = floatBitsToInt(vb.v[i0 + 8u]);
            int   flags  = floatBitsToInt(vb.v[i0 + 9u]);
            uint  id     = isSprite ? (pc.misc4.x + uint(texnum))
                         : (((flags & FLAG_FLAT) != 0) ? (pc.misc.w + uint(texnum))
                                                       : uint(texnum));
            vec3  albedo = decodeAlbedo(id, hitUV);
            float tHit   = rayQueryGetIntersectionTEXT(rq, true);
            vec3  hitP   = origin + dir * tHit;

            // build step 6c (half-resolution lighting): the G-buffer (position /
            // normal / albedo) is written at FULL resolution for EVERY pixel — it
            // carries the sharp edges the denoiser upsample and demodulation lean on.
            // The expensive part — the live direct/NEE shadow rays + the muzzle-flash
            // shadow ray — is the half-res lever: only the even/even pixel of each 2x2
            // block casts it. The other three pixels are reconstructed in the temporal
            // pass from these grid samples, guided by this full-res G-buffer. gillum.a
            // flags a real sample (1) vs a pixel to reconstruct (0).
            // DOOM-0084: galbedo.a carries the self-emission ENABLE (1 = world surface
            // or a fullbright light sprite; 0 = a non-light sprite — pickup/monster),
            // so the composite re-adds emission only where it belongs.
            bool addEmis = isSprite ? ((flags & FLAG_EMISSIVE) != 0) : true;
            uint par = pc.misc3.w;
            imageStore(gpos[par],  ivec2(px), vec4(hitP, float(id)));
            imageStore(gnorm[par], ivec2(px), vec4(n, 0.0));
            imageStore(galbedo,    ivec2(px), vec4(albedo, addEmis ? 1.0 : 0.0));
            if (((px.x | px.y) & 1u) != 0u) {       // not an even/even grid sample
                imageStore(gillum, ivec2(px), vec4(0.0));
                return;
            }

            // Direct NEE with albedo 1 + no emission -> the pure incident/PI direct
            // irradiance; baked GI irradiance is already albedo-free; the muzzle
            // flash term likewise without albedo. albedo/emission ride separately.
            // Seed folds in the frame counter (misc3.x) so each frame is an
            // INDEPENDENT sample -> temporal accumulation converges and the SVGF
            // variance estimate is non-zero (a frozen seed defeats the denoiser).
            uint seed  = pcgHash(px.x + px.y * w + 1u + pc.misc3.x * 2654435761u);
            vec3 illum = shadeSurface(hitP, n, vec3(1.0), id, pc.misc2.x,
                                      pc.emit, pc.matEmis, NEE_SAMPLES, false, seed);
            // GI bounce + DOOM-0043 sector-light ambient floor (demodulated: the
            // composite re-applies albedo). Same max() floor as mode 4 so a bright-
            // marked but unlit room reads, while dark sectors stay dark.
            float secLight = vb.v[i0 + 10u];                       // sector lightlevel 0..1
            vec3  ambient  = vec3(max(secLight * AMBIENT_SECTOR_SCALE, AMBIENT_FLOOR));
            uint  subId    = isSprite ? 0xFFFFFFFFu : pc.triSs.s[uint(prim)];  // sprites: no GI probe
            vec3  gi       = (subId < pc.misc2.y) ? giIrradiance(pc.probes, subId, n)
                                                  : vec3(0.0);
            illum += max(gi, ambient);

            float flash = uintBitsToFloat(pc.misc2.z);
            if (flash > 0.0)
            {
                vec3  muzzle = pc.camPos.xyz + pc.camDir.xyz * MUZZLE_FORWARD
                             + vec3(0.0, 0.0, -MUZZLE_DROP);
                vec3  md    = muzzle - hitP;
                float mdist2 = dot(md, md);
                float mdist  = sqrt(mdist2);
                vec3  mwi    = md / mdist;
                float mcos   = dot(n, mwi);
                if (mcos > 0.0 && mdist2 > 1.0)
                {
                    rayQueryEXT sq;
                    rayQueryInitializeEXT(sq, topAS,
                        gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT, 0x01u,
                        hitP + n * 1e-3, 1e-3, mwi, mdist - 2e-3);
                    while (rayQueryProceedEXT(sq)) {}
                    if (rayQueryGetIntersectionTypeEXT(sq, true)
                        == gl_RayQueryCommittedIntersectionNoneEXT)
                        illum += (1.0 / PI) * FLASH_COLOR
                               * (flash * FLASH_INTENSITY) * mcos
                               / (mdist2 + FLASH_RADIUS2);
                }
            }

            // DOOM-0044 flashlight, demodulated (the composite re-applies albedo).
            // Same eye-mounted spotlight + ray-traced shadow as mode 4, sans albedo.
            if (pc.misc2.w != 0u)
            {
                vec3  fl    = pc.camPos.xyz - hitP;     // surface -> eye (the lamp)
                float fl2   = dot(fl, fl);
                float fdist = sqrt(fl2);
                vec3  fwi   = fl / fdist;
                float fcos  = dot(n, fwi);
                float spot  = smoothstep(FLASHLIGHT_COS_OUT, FLASHLIGHT_COS_IN,
                                         dot(-fwi, pc.camDir.xyz));
                if (fcos > 0.0 && spot > 0.0 && fl2 > 1.0)
                {
                    rayQueryEXT sq;
                    rayQueryInitializeEXT(sq, topAS,
                        gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT, 0x01u,
                        hitP + n * 1e-3, 1e-3, fwi, fdist - 2e-3);
                    while (rayQueryProceedEXT(sq)) {}
                    if (rayQueryGetIntersectionTypeEXT(sq, true)
                        == gl_RayQueryCommittedIntersectionNoneEXT)
                        illum += (1.0 / PI) * FLASHLIGHT_COLOR
                               * (FLASHLIGHT_INTENSITY * spot) * fcos
                               / (fl2 + FLASHLIGHT_RADIUS2);
                }
            }

            if (any(isnan(illum)) || any(isinf(illum))) illum = vec3(0.0);
            imageStore(gillum, ivec2(px), vec4(illum, 1.0));
            return;                                 // feed writes the G-buffer only
        }
        else
        {
            colour = n * 0.5 + 0.5;                 // intersection / normal view
        }
    }
    else
    {
        // Miss: the environment. Mode 5 (verify) leaves the accum texel untouched
        // (count stays 0 -> the host skips background pixels). Unit radiance in
        // furnace mode (energy stays flat across hit and miss); the bounded
        // sky-light in NEE mode (tonemapped like the lit surfaces); a dark sky in
        // intersection mode.
        if      (mode == 5u) return;
        else if (mode == 6u)
        {
            // Sky in the denoise feed: matId < 0 flags it, the stored linear
            // SKY_COLOR passes through the denoiser and is tonemapped by composite.
            uint par = pc.misc3.w;
            imageStore(gpos[par],  ivec2(px), vec4(0.0, 0.0, 0.0, -1.0));
            imageStore(gnorm[par], ivec2(px), vec4(0.0, 0.0, 1.0, 0.0));
            imageStore(galbedo,    ivec2(px), vec4(0.0));
            imageStore(gillum,     ivec2(px), vec4(SKY_COLOR, 0.0));
            return;
        }
        else if (mode == 2u) colour = vec3(1.0);
        else if (mode == 4u) colour = toneEncode(SKY_COLOR);
        else                 colour = vec3(0.02, 0.02, 0.05);
    }

    imageStore(outImg, ivec2(px), vec4(colour, 1.0));
}
