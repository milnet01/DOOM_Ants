#version 460
//
// DOOM-0009 path tracer — build steps 2c/3a/3c.
//
// A compute megakernel that casts one primary ray per pixel against the level
// TLAS (built in step 2b) via VK_KHR_ray_query, and writes an image the present
// path blits to the swapchain. Modes 1-3 are diagnostics; mode 4 is the first
// real lit output. Selected by the host (the `~` debug toggle, off -> 1..4):
//
//   mode 1  INTERSECTION  — traversal + camera sanity. On a hit, colour by the
//                           surface normal (n*0.5+0.5); on a miss, a dark sky.
//                           Should line up face-for-face with the raster view.
//   mode 2  WHITE FURNACE  — energy sanity for the sampling math step 3 reuses.
//                           Every hit does one cosine-weighted diffuse bounce
//                           into a constant unit-radiance environment with
//                           albedo 1 and NO occlusion: the estimator
//                           brdf*cos/pdf = albedo = 1 exactly, with zero
//                           variance. So a correct integrator paints the whole
//                           screen flat white; any tint/banding is an energy
//                           bug in the pdf/throughput code.
//   mode 3  TEXTURED       — build step 3a: fetch the hit surface's real DOOM
//                           material (paletted texture decoded through PLAYPAL,
//                           exactly as the raster mesh.frag does) and modulate by
//                           sector lightlevel. The honest "albedo recovered +
//                           sector-light seed" view; real NEE direct lighting
//                           replaces the flat sector-light term in step 3c.
//   mode 4  NEE DIRECT    — build step 3c: linear albedo + the surface's own
//                           emission, plus direct light estimated by shadow-
//                           sampling the step-3b emitter list (hard ray-traced
//                           shadows), a flat sky ambient standing in for the
//                           step-4 GI bake, Reinhard-tonemapped. The first lit
//                           image: lamps/screens/slime/lit switches cast light.
//
#extension GL_EXT_ray_query           : require
#extension GL_EXT_buffer_reference     : require
#extension GL_EXT_scalar_block_layout  : require
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT topAS;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D outImg;

// Materials (set 1) — shared verbatim with the raster pass (r_vulkan.cpp
// CreateDescriptors / mesh.frag): the 256x1 PLAYPAL LUT and the bindless array of
// R8 palette-index material images. Same binding numbers (0, 2) and the same
// g.ds set bound at trace time, so the traced surface decodes to DOOM's exact
// colours with no parallel material path.
layout(set = 1, binding = 0) uniform sampler2D paletteTex;
layout(set = 1, binding = 2) uniform sampler2D materialTex[];

// The level mesh vertex buffer, read by GPU address so a hit can fetch the
// triangle's per-vertex data. Matches rb_vertex_t (r_mesh.h): 18 4-byte slots/
// vertex — position [0..2], normal [3..5], texel u/v [6..7], texnum [8] (int),
// flags [9] (int), sector light [10] (float). scalar layout = tight packing; the
// int fields are recovered with floatBitsToInt. (The trace hits only static
// walls/flats — sprites and the sky backdrop are per-frame, not in the BLAS — so
// the unified material id needs only the numWall offset, not numFlat.)
layout(buffer_reference, scalar) readonly buffer Verts { float v[]; };

// Emitter list (build step 3b) — the subset of static level triangles whose
// material is emissive (a bright lamp/screen/switch/slime texture crossing the
// build-time luminance threshold). Each record is 12 tight floats: v0[3] v1[3]
// v2[3] Le[3] (world positions + linear emitted radiance). NEE (step 3c) samples
// a point on one of these per shading point and shadow-rays to it.
layout(buffer_reference, scalar) readonly buffer Emitters { float e[]; };

// Per-material emitted radiance Le, indexed by the same unified material id the
// textured decode uses (walls [0,numWall), flats after). Lets a primary hit add
// its own self-emission (a lamp you look at directly glows) without re-deriving
// the per-texture mean. 3 floats/material (linear RGB).
layout(buffer_reference, scalar) readonly buffer MatEmis { float m[]; };

layout(push_constant) uniform PC {
    vec4  camPos;    // xyz = ray origin (world)
    vec4  camDir;    // xyz = forward
    vec4  camRight;  // xyz = right,  w = tan(hFov/2)
    vec4  camUp;     // xyz = up,     w = tan(vFov/2)
    uvec4 misc;      // x = mode, y = width, z = height, w = numWall (flat-id offset)
    uvec4 misc2;     // x = emitter count (step 3b); y,z,w reserved
    Verts    verts;    // level mesh vertex buffer (device address)
    Emitters emit;     // step-3b emitter list (device address; count in misc2.x)
    MatEmis  matEmis;  // per-material Le table (device address)
} pc;

const float PI = 3.14159265358979323846;
const int FLAG_FLAT = 0x1;   // matches RB_MESH_FLAT in r_mesh.h (flats vs walls)

// Cheap integer hash (PCG) -> a float in [0,1), for the furnace bounce sample.
uint pcgHash(uint x)
{
    uint state = x * 747796405u + 2891336453u;
    uint word  = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}
float rnd(inout uint s) { s = pcgHash(s); return float(s) * (1.0 / 4294967296.0); }

// --- NEE direct lighting (build step 3c) -------------------------------------
// INV-7 backfill: provisional inline curves/thresholds (user-approved 2026-06-27)
// pending the Vestige Formula Workbench export.
const uint  NEE_SAMPLES = 4u;          // shadow rays/pixel. Emitters are picked by
                                       // POWER (build step 3c-2, cdf binary search),
                                       // so a few samples land on the lights that
                                       // matter — 4 here is cleaner than the old 16
                                       // uniform picks at a quarter of the ray cost.
// Sector lightlevel is the scene's real illumination (DOOM's small emissive
// textures alone subtend a tiny solid angle -> faint), so it seeds a moody
// ambient fill here; the step-4 GI bake replaces this flat term with a true
// bounce solution. NEE lamps then pool brighter light + cast shadows on top.
const float SECTOR_FILL   = 0.20;      // sector-lightlevel -> ambient fill scale
const float AMBIENT_FLOOR = 0.02;      // floor so unlit sectors aren't pure black
const vec3  SKY_COLOR     = vec3(0.20, 0.26, 0.40);  // bounded sky-light (miss env)
const float FIREFLY_MAX   = 4.0;       // clamp one NEE sample's *reflected radiance*
                                       // (post-BRDF) — bounds near-lamp spikes while
                                       // preserving distance falloff farther out
const float EXPOSURE      = 4.0;       // linear pre-tonemap gain. DOOM's derived
                                       // radiances are low; this lifts the lit scene
                                       // to a readable level before the Reinhard
                                       // roll-off (the §5 PBR-Neutral exposure curve,
                                       // INV-7 backfill — provisional inline value).

// Reinhard tonemap + sRGB-ish encode: the integrator works in linear radiance,
// the swapchain is UNORM, so map HDR->[0,1] and gamma-encode for display.
vec3 toneEncode(vec3 L)
{
    L = max(L, vec3(0.0));
    vec3 m = L / (L + vec3(1.0));
    return pow(m, vec3(1.0 / 2.2));
}

// One area-sampled direct-lighting estimate from emitter triangle k. Returns the
// incident contribution (Le * geometry / pdf), WITHOUT the surface BRDF (the
// caller folds in albedo/pi). The caller picks k by power (build step 3c-2) with
// selection probability pdfSel, and samples a uniform point on the triangle, so
// p(Q) = pdfSel * (1/area) and 1/p = area / pdfSel.
vec3 sampleEmitter(uint k, vec3 hitP, vec3 n, float pdfSel, inout uint seed)
{
    uint b = k * 14u;
    vec3 v0 = vec3(pc.emit.e[b+0u],  pc.emit.e[b+1u],  pc.emit.e[b+2u]);
    vec3 v1 = vec3(pc.emit.e[b+3u],  pc.emit.e[b+4u],  pc.emit.e[b+5u]);
    vec3 v2 = vec3(pc.emit.e[b+6u],  pc.emit.e[b+7u],  pc.emit.e[b+8u]);
    vec3 Le = vec3(pc.emit.e[b+9u],  pc.emit.e[b+10u], pc.emit.e[b+11u]);

    vec3 e1 = v1 - v0, e2 = v2 - v0;
    vec3 ng = cross(e1, e2);
    float area2 = length(ng);                  // = 2 * triangle area
    if (area2 < 1e-8) return vec3(0.0);
    vec3  nL   = ng / area2;
    float area = 0.5 * area2;

    // Uniform point on the triangle (reflected barycentric).
    float r1 = rnd(seed), r2 = rnd(seed);
    if (r1 + r2 > 1.0) { r1 = 1.0 - r1; r2 = 1.0 - r2; }
    vec3 Q = v0 + e1 * r1 + e2 * r2;

    vec3  d     = Q - hitP;
    float dist2 = dot(d, d);
    if (dist2 < 1e-6) return vec3(0.0);
    float dist = sqrt(dist2);
    vec3  wi   = d / dist;

    float cosSurf = dot(n, wi);
    if (cosSurf <= 0.0) return vec3(0.0);      // emitter is behind the surface
    float cosL = abs(dot(nL, wi));             // two-sided (DOOM faces emit both ways)
    if (cosL <= 0.0) return vec3(0.0);

    // Occlusion: opaque any-hit, terminate on first hit. tMax just short of the
    // light so the emitter face itself doesn't self-occlude.
    rayQueryEXT sq;
    rayQueryInitializeEXT(sq, topAS,
        gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT, 0xFFu,
        hitP + n * 1e-3, 1e-3, wi, dist - 2e-3);
    while (rayQueryProceedEXT(sq)) {}
    if (rayQueryGetIntersectionTypeEXT(sq, true)
        != gl_RayQueryCommittedIntersectionNoneEXT)
        return vec3(0.0);                      // shadowed

    float G   = cosSurf * cosL / dist2;
    float inv = area / pdfSel;                  // 1 / p(Q), p = pdfSel * (1/area)
    return Le * G * inv;
}

void main()
{
    const uvec2 px = gl_GlobalInvocationID.xy;
    const uint  w  = pc.misc.y;
    const uint  h  = pc.misc.z;
    if (px.x >= w || px.y >= h)
        return;

    // Primary ray: pixel centre -> NDC [-1,1], screen-y down so world up = -ndcY.
    const float ndcX = (2.0 * (float(px.x) + 0.5) / float(w)) - 1.0;
    const float ndcY = (2.0 * (float(px.y) + 0.5) / float(h)) - 1.0;
    const vec3  origin = pc.camPos.xyz;
    const vec3  dir = normalize(pc.camDir.xyz
                              + pc.camRight.xyz * (ndcX * pc.camRight.w)
                              + pc.camUp.xyz    * (-ndcY * pc.camUp.w));

    const uint mode = pc.misc.x;

    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, topAS, gl_RayFlagsOpaqueEXT, 0xFFu,
                          origin, 0.01, dir, 1.0e9);
    while (rayQueryProceedEXT(rq)) {}

    vec3 colour;
    if (rayQueryGetIntersectionTypeEXT(rq, true)
        == gl_RayQueryCommittedIntersectionTriangleEXT)
    {
        // Baked world normal from the hit triangle's first vertex (flat-shaded
        // DOOM geometry shares one normal across the face). Non-indexed soup, so
        // vertex 0 of triangle p is at p*3.
        const int  prim = rayQueryGetIntersectionPrimitiveIndexEXT(rq, true);
        const uint i0   = uint(prim) * 3u * 18u;   // 18 floats/vertex
        vec3 n = vec3(pc.verts.v[i0 + 3u], pc.verts.v[i0 + 4u], pc.verts.v[i0 + 5u]);
        n = normalize(n);
        if (dot(n, dir) > 0.0) n = -n;             // face the viewer

        if (mode == 2u)
        {
            // White furnace: one cosine-weighted bounce, constant env L = 1,
            // albedo = 1, no occlusion. weight = brdf*cos/pdf = albedo, exactly.
            uint  seed = px.x + px.y * w;
            float u1 = rnd(seed), u2 = rnd(seed);
            vec3  t  = normalize(cross(abs(n.z) < 0.999 ? vec3(0,0,1) : vec3(1,0,0), n));
            vec3  b  = cross(n, t);
            float r  = sqrt(u1), phi = 2.0 * PI * u2;
            vec3  sd = t * (r * cos(phi)) + b * (r * sin(phi)) + n * sqrt(max(0.0, 1.0 - u1));
            float cosT = max(dot(n, sd), 0.0);
            float pdf  = cosT / PI;
            float brdf = 1.0 / PI;                  // albedo 1 Lambert
            float L    = 1.0;
            colour = vec3(pdf > 0.0 ? (brdf * cosT / pdf) * L : 0.0);
        }
        else if (mode == 3u)
        {
            // Textured (3a): decode the hit surface's DOOM material exactly as the
            // raster path (mesh.frag) does, then modulate by sector lightlevel.
            // Per-vertex data of the hit triangle's vertex 0 (flat-shaded faces
            // share it across all three vertices, like the normal above).
            float u     = pc.verts.v[i0 + 6u];
            float vv    = pc.verts.v[i0 + 7u];
            int   texnum = floatBitsToInt(pc.verts.v[i0 + 8u]);
            int   flags  = floatBitsToInt(pc.verts.v[i0 + 9u]);
            float light  = pc.verts.v[i0 + 10u];

            // Unified bindless id: flats sit after the walls (offset numWall);
            // walls (including two-sided masked mid-walls) index by texnum direct.
            // The ray is opaque (gl_RayFlagsOpaqueEXT), so a masked mid-wall reads
            // solid here — its index-0 cut-out gaps become see-through only once
            // any-hit alpha testing lands (a later refinement, with NEE in 3c).
            int  id    = ((flags & FLAG_FLAT) != 0) ? (int(pc.misc.w) + texnum) : texnum;
            vec2 sz    = vec2(textureSize(materialTex[nonuniformEXT(id)], 0));
            float idx  = texture(materialTex[nonuniformEXT(id)], vec2(u, vv) / sz).r * 255.0;
            vec3 albedo = texture(paletteTex, vec2((idx + 0.5) / 256.0, 0.5)).rgb;

            colour = albedo * light;                // sector-light seed; NEE in 3c
        }
        else if (mode == 4u)
        {
            // NEE direct lighting (build step 3c). Decode the surface albedo (as
            // mode 3) into linear space, add the surface's own emission (so a lamp
            // you look at directly glows), then estimate direct light by shadow-
            // sampling the emitter list. A flat sky ambient stands in for the step-4
            // GI bake so lamp-less rooms aren't pure black.
            float u      = pc.verts.v[i0 + 6u];
            float vv     = pc.verts.v[i0 + 7u];
            int   texnum = floatBitsToInt(pc.verts.v[i0 + 8u]);
            int   flags  = floatBitsToInt(pc.verts.v[i0 + 9u]);
            float sLight = pc.verts.v[i0 + 10u];    // owning sector lightlevel, 0..1
            int  id    = ((flags & FLAG_FLAT) != 0) ? (int(pc.misc.w) + texnum) : texnum;
            vec2 sz    = vec2(textureSize(materialTex[nonuniformEXT(id)], 0));
            float idx  = texture(materialTex[nonuniformEXT(id)], vec2(u, vv) / sz).r * 255.0;
            vec3 albedo = texture(paletteTex, vec2((idx + 0.5) / 256.0, 0.5)).rgb;
            albedo = pow(albedo, vec3(2.2));        // palette is gamma-encoded -> linear

            float tHit = rayQueryGetIntersectionTEXT(rq, true);
            vec3  hitP = origin + dir * tHit;

            // Self-emission (linear) from the per-material Le table.
            vec3 L = vec3(pc.matEmis.m[uint(id) * 3u + 0u],
                          pc.matEmis.m[uint(id) * 3u + 1u],
                          pc.matEmis.m[uint(id) * 3u + 2u]);

            // Direct light: average NEE_SAMPLES emitter samples (each an unbiased
            // estimate of the whole emitter set). Emitters are picked by POWER —
            // binary-search the cdf stored per record (slot 12) so bright/large
            // lights are chosen proportionally more often, then weight by 1/pdf
            // (slot 13). Clamp per sample in the reflected-radiance domain (after
            // BRDF albedo/PI) so the firefly limit is a real luminance bound.
            uint count = pc.misc2.x;
            if (count > 0u)
            {
                uint seed = px.x + px.y * w + 1u;
                vec3 direct = vec3(0.0);
                for (uint si = 0u; si < NEE_SAMPLES; si++)
                {
                    float u  = rnd(seed);
                    uint  lo = 0u, hi = count - 1u;        // first k with cdf[k] >= u
                    while (lo < hi)
                    {
                        uint mid = (lo + hi) >> 1u;
                        if (pc.emit.e[mid * 14u + 12u] < u) lo = mid + 1u;
                        else                                hi = mid;
                    }
                    float pdf = pc.emit.e[lo * 14u + 13u];
                    vec3  c   = sampleEmitter(lo, hitP, n, pdf, seed);
                    vec3  rad = albedo * (1.0 / PI) * c;    // reflected radiance
                    direct += min(rad, vec3(FIREFLY_MAX));
                }
                L += direct / float(NEE_SAMPLES);
            }

            // Sector-light ambient fill (TEMP stand-in for the step-4 GI bake).
            L += albedo * (sLight * SECTOR_FILL + AMBIENT_FLOOR);

            if (any(isnan(L)) || any(isinf(L))) L = vec3(0.0);
            colour = toneEncode(L * EXPOSURE);
        }
        else
        {
            colour = n * 0.5 + 0.5;                 // intersection / normal view
        }
    }
    else
    {
        // Miss: the environment. Unit radiance in furnace mode (energy stays flat
        // across hit and miss); the bounded sky-light in NEE mode (tonemapped like
        // the lit surfaces); a dark sky in intersection mode.
        if      (mode == 2u) colour = vec3(1.0);
        else if (mode == 4u) colour = toneEncode(SKY_COLOR * EXPOSURE);
        else                 colour = vec3(0.02, 0.02, 0.05);
    }

    imageStore(outImg, ivec2(px), vec4(colour, 1.0));
}
