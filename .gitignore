# Build output
*.o
*.obj
*.exe
*.so
*.a
linuxdoom
linuxxdoom
doom
/packaging/build/
cmake-build-*/
# DOOM Makefile object dirs (O=linux native, O=mingw Windows cross-build)
/linuxdoom-1.10/linux/
/linuxdoom-1.10/mingw/

# Windows cross-build dependencies (DOOM-0006): downloaded upstream SDL2 /
# SDL2_mixer / Vulkan mingw dev libs. Regenerable — see mingw-deps/README.md.
/mingw-deps/*
!/mingw-deps/README.md

# AppImage packaging (DOOM-0007): downloaded tools + staging tree. The build
# script, desktop file and icon are tracked; tools/ and build/ are not.
/packaging/tools/
/packaging/build/

# Compilation database for the static analysers (`make compile_commands.json`).
# Generated, and only true of the build that produced it — regenerate, don't commit.
/linuxdoom-1.10/compile_commands.json

# Generated shader artifacts (DOOM-0008): GLSL -> SPIR-V -> embedded C header
/linuxdoom-1.10/shaders/*.spv
/linuxdoom-1.10/shaders/*.spv.h

# Generated embedded-asset artifacts (DOOM-0206): bundled .ttf -> C byte array
/linuxdoom-1.10/assets/*.ttf.h

# Editor / OS cruft
*.swp
*~
.DS_Store
.vscode/
.idea/

# Game data — never commit WADs (licensing)
*.wad
*.WAD
# Local WAD/data folder (WADs plus their .zip archives) — licensing, never commit
/wads/

# Save games — per-player runtime state, not source (doomsav0..5.dsg)
*.dsg

# ants-audit tooling artifacts
.audit_cache/
# indie-review working reports (transient per-run; findings are folded into ROADMAP)
.indie-review/
audit_rule_quality.json
/run-doom-ants.sh

# Ants MCP roadmap ID allocator — a purely local next-ID counter, not source.
/.roadmap-counter

# Python bytecode cache (scripts/pbr_derive.py, make_bringup_hero.py)
__pycache__/
*.pyc

# DOOM-0294 developer screenshots (make DEV=1 only; never part of a release).
# DOOM-0335: NOT path-anchored on purpose. rb_devshot_path creates dev-shots/
# relative to the process working directory, and run-doom-ants.sh plus every
# headless capture recipe launch from the REPO ROOT — so the directory that
# actually fills up is <repo>/dev-shots/, which the old
# `linuxdoom-1.10/dev-shots/` rule never covered. This form covers both.
dev-shots/

# Trailer shooting script (DOOM-0339). Local working document: production notes
# and title-card wording, of no use to anyone cloning the engine. Kept on disk
# and edited freely; deliberately not versioned (user, 2026-08-07).
docs/trailer-script.md
